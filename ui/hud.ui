			[box $anb_8 width=17em] { [span $aname_8 color=#f1efe6 font-size=16 text=" "] }
			[box $asb_8] { [span $ast_8 color=#e8952a font-size=13 text=" "] }
		}
		[box $acard_9 .lrow on-click=abuild_9 visible=false direction=row wrap=false align-items=center] {
			[box $athumb_9 bg-image="ui/att_9.spr" width=2.2em height=2.2em margin-left=0.75em margin-right=0.75em] {}
			[box $anb_9 width=17em] { [span $aname_9 color=#f1efe6 font-size=16 text=" "] }
			[box $asb_9] { [span $ast_9 color=#e8952a font-size=13 text=" "] }
		}
		[box $acard_10 .lrow on-click=abuild_10 visible=false direction=row wrap=false align-items=center] {
			[box $athumb_10 bg-image="ui/att_10.spr" width=2.2em height=2.2em margin-left=0.75em margin-right=0.75em] {}
			[box $anb_10 width=17em] { [span $aname_10 color=#f1efe6 font-size=16 text=" "] }
			[box $asb_10] { [span $ast_10 color=#e8952a font-size=13 text=" "] }
		}
	}
	[box $build_empty width=33em visible=false] { [span $b_empty color=#b9c3cb font-size=14 text=" "] }
}

// ================= bottom right: info terminal and time =================
// ================= right: selected module =================
[box $modinfo .panel position=absolute left=99% pivot-x=100% top=50% pivot-y=50% width=23em direction=column visible=false font-size=15] {
	[box direction=row wrap=false] { [box width=18.2em] { [span $mi_title color=#e6ac3c font-size=17 text=" "] } [box .btn on-click=mclose width=1.8em] { x } }
	[box width=19.4em padding-bottom=0.3em] { [span $mi_hp color=#f1efe6 text=" "] [span $mi_hp_bad color=#ff7a6a text=" " visible=false] }
	[box .bar width=19.4em] { [box $mi_bar width=100% height=0.4em bg-color=#6fb7d9] }
	[box $mi_task width=19.4em visible=false] { [span $mi_task_t color=#e6ac3c text=" "] }
	[box $mi_r1 .row width=19.4em] { [span $mi_l1 color=#c9d1d7 text=" "] }
	[box $mi_r2 .row width=19.4em] { [span $mi_l2 color=#c9d1d7 text=" "] }
	[box $mi_r3 .row width=19.4em] { [span $mi_l3 color=#c9d1d7 text=" "] }
	[box $mi_r4 .row width=19.4em] { [span $mi_l4 color=#c9d1d7 text=" "] }
	[box $mi_r5 .row width=19.4em] { [span $mi_l5 color=#c9d1d7 text=" "] }
	[box $mi_r6 .row width=19.4em] { [span $mi_l6 color=#c9d1d7 text=" "] }
	[box $mi_r7 .row width=19.4em] { [span $mi_l7 color=#c9d1d7 text=" "] }
	[box $mi_r8 .row width=19.4em] { [span $mi_l8 color=#c9d1d7 text=" "] }
	[box $mi_r9 .row width=19.4em] { [span $mi_l9 color=#c9d1d7 text=" "] }
	[box $mi_r10 .row width=19.4em] { [span $mi_l10 color=#c9d1d7 text=" "] }
	[box $mi_r11 .row width=19.4em] { [span $mi_l11 color=#c9d1d7 text=" "] }
	[box $mi_r12 .row width=19.4em] { [span $mi_l12 color=#c9d1d7 text=" "] }
	[box .btn on-click=mrepair margin-top=0.4em] { [span $mi_repair text="Repair module"] }
	[box $mi_boost .btn on-click=boost visible=false] { [span $mi_boost_t text="Reboost"] }
	[box $mi_dis .btn on-click=mdismantle visible=false] { [span $mi_dis_t text="Dismantle"] }
	[box $mi_ship .btn on-click=mship visible=false] { [span $mi_ship_t text="Build shuttle"] }
	[box $rk_free width=19.4em padding-top=0.5em visible=false] { [span $rk_free_t color=#e6ac3c text=" "] }
	[box $rk_1 direction=row wrap=false align-items=center visible=false] { [box width=7.4em] { [span $rk_t_1 color=#c9d1d7 text=" "] } [box $rkj_1 .btn on-click=rkjob_1 width=3.2em visible=false] { [span $rkj_t_1 text="sort"] } [box $rks_1 .btn on-click=rkstaff_1 width=4.4em] { [span $rks_t_1 text="staff"] } [box .btn on-click=rkdis_1 width=4.6em] { remove } }
	[box $rk_2 direction=row wrap=false align-items=center visible=false] { [box width=7.4em] { [span $rk_t_2 color=#c9d1d7 text=" "] } [box $rkj_2 .btn on-click=rkjob_2 width=3.2em visible=false] { [span $rkj_t_2 text="sort"] } [box $rks_2 .btn on-click=rkstaff_2 width=4.4em] { [span $rks_t_2 text="staff"] } [box .btn on-click=rkdis_2 width=4.6em] { remove } }
	[box $rk_3 direction=row wrap=false align-items=center visible=false] { [box width=7.4em] { [span $rk_t_3 color=#c9d1d7 text=" "] } [box $rkj_3 .btn on-click=rkjob_3 width=3.2em visible=false] { [span $rkj_t_3 text="sort"] } [box $rks_3 .btn on-click=rkstaff_3 width=4.4em] { [span $rks_t_3 text="staff"] } [box .btn on-click=rkdis_3 width=4.6em] { remove } }
	[box $rk_4 direction=row wrap=false align-items=center visible=false] { [box width=7.4em] { [span $rk_t_4 color=#c9d1d7 text=" "] } [box $rkj_4 .btn on-click=rkjob_4 width=3.2em visible=false] { [span $rkj_t_4 text="sort"] } [box $rks_4 .btn on-click=rkstaff_4 width=4.4em] { [span $rks_t_4 text="staff"] } [box .btn on-click=rkdis_4 width=4.6em] { remove } }
	[box $rk_5 direction=row wrap=false align-items=center visible=false] { [box width=7.4em] { [span $rk_t_5 color=#c9d1d7 text=" "] } [box $rkj_5 .btn on-click=rkjob_5 width=3.2em visible=false] { [span $rkj_t_5 text="sort"] } [box $rks_5 .btn on-click=rkstaff_5 width=4.4em] { [span $rks_t_5 text="staff"] } [box .btn on-click=rkdis_5 width=4.6em] { remove } }
	[box $rk_6 direction=row wrap=false align-items=center visible=false] { [box width=7.4em] { [span $rk_t_6 color=#c9d1d7 text=" "] } [box $rkj_6 .btn on-click=rkjob_6 width=3.2em visible=false] { [span $rkj_t_6 text="sort"] } [box $rks_6 .btn on-click=rkstaff_6 width=4.4em] { [span $rks_t_6 text="staff"] } [box .btn on-click=rkdis_6 width=4.6em] { remove } }
	[box $rk_7 direction=row wrap=false align-items=center visible=false] { [box width=7.4em] { [span $rk_t_7 color=#c9d1d7 text=" "] } [box $rkj_7 .btn on-click=rkjob_7 width=3.2em visible=false] { [span $rkj_t_7 text="sort"] } [box $rks_7 .btn on-click=rkstaff_7 width=4.4em] { [span $rks_t_7 text="staff"] } [box .btn on-click=rkdis_7 width=4.6em] { remove } }
	[box $rk_8 direction=row wrap=false align-items=center visible=false] { [box width=7.4em] { [span $rk_t_8 color=#c9d1d7 text=" "] } [box $rkj_8 .btn on-click=rkjob_8 width=3.2em visible=false] { [span $rkj_t_8 text="sort"] } [box $rks_8 .btn on-click=rkstaff_8 width=4.4em] { [span $rks_t_8 text="staff"] } [box .btn on-click=rkdis_8 width=4.6em] { remove } }
	[box $rk_9 direction=row wrap=false align-items=center visible=false] { [box width=7.4em] { [span $rk_t_9 color=#c9d1d7 text=" "] } [box $rkj_9 .btn on-click=rkjob_9 width=3.2em visible=false] { [span $rkj_t_9 text="sort"] } [box $rks_9 .btn on-click=rkstaff_9 width=4.4em] { [span $rks_t_9 text="staff"] } [box .btn on-click=rkdis_9 width=4.6em] { remove } }
	[box $rk_10 direction=row wrap=false align-items=center visible=false] { [box width=7.4em] { [span $rk_t_10 color=#c9d1d7 text=" "] } [box $rkj_10 .btn on-click=rkjob_10 width=3.2em visible=false] { [span $rkj_t_10 text="sort"] } [box $rks_10 .btn on-click=rkstaff_10 width=4.4em] { [span $rks_t_10 text="staff"] } [box .btn on-click=rkdis_10 width=4.6em] { remove } }
}
[box $tip .term position=absolute left=49.6em top=4.5em width=26em direction=column visible=false font-size=18] {
	[box width=23.4em] { [span $tip_title color=#a8ffd2 font-size=17 text=" "] }
	[box width=23.4em] { [span $tip_desc color=#78e6ae text=" "] }
	[box width=23.4em padding-top=0.5em] { [span $tip_fx color=#e6ac3c text=" "] }
	[box width=23.4em padding-top=0.5em] { [span $tip_cost color=#dfe6ec text=" "] }
}

// ================= centre: game over / victory =================
[box $banner .panelb position=absolute left=50% pivot-x=50% top=45% pivot-y=50% width=34em align=center visible=false font-size=22] {
	[box] { [span $banner_text text=" "] }
	[box $restart_btn .btnon width=14em on-click=restart visible=false] { Restart station }
}

// ================= crew choice popup (hud.evox askCrew): every order that needs someone asks who =================
[box $crewpick .panelb position=absolute left=50% pivot-x=50% top=28% width=21em font-size=16 direction=column visible=false] {
	[box .hd] { A S S I G N }
	[box $pk_1 .btn on-click=pick1 width=16.6em visible=false] { [box] { [span $pk_n_1 font-size=18 color=#f1efe6 text=" "] [span $pk_t_1 font-size=13 color=#8b97a3 text=" "] } [box padding-top=0.15em] { [span $pk_s_1 font-size=12 color=#e6ac3c text=" "] } }
	[box $pk_2 .btn on-click=pick2 width=16.6em visible=false] { [box] { [span $pk_n_2 font-size=18 color=#f1efe6 text=" "] [span $pk_t_2 font-size=13 color=#8b97a3 text=" "] } [box padding-top=0.15em] { [span $pk_s_2 font-size=12 color=#e6ac3c text=" "] } }
	[box $pk_3 .btn on-click=pick3 width=16.6em visible=false] { [box] { [span $pk_n_3 font-size=18 color=#f1efe6 text=" "] [span $pk_t_3 font-size=13 color=#8b97a3 text=" "] } [box padding-top=0.15em] { [span $pk_s_3 font-size=12 color=#e6ac3c text=" "] } }
	[box $pk_4 .btn on-click=pick4 width=16.6em visible=false] { [box] { [span $pk_n_4 font-size=18 color=#f1efe6 text=" "] [span $pk_t_4 font-size=13 color=#8b97a3 text=" "] } [box padding-top=0.15em] { [span $pk_s_4 font-size=12 color=#e6ac3c text=" "] } }
	[box $pk_5 .btn on-click=pick5 width=16.6em visible=false] { [box] { [span $pk_n_5 font-size=18 color=#f1efe6 text=" "] [span $pk_t_5 font-size=13 color=#8b97a3 text=" "] } [box padding-top=0.15em] { [span $pk_s_5 font-size=12 color=#e6ac3c text=" "] } }
	[box $pk_6 .btn on-click=pick6 width=16.6em visible=false] { [box] { [span $pk_n_6 font-size=18 color=#f1efe6 text=" "] [span $pk_t_6 font-size=13 color=#8b97a3 text=" "] } [box padding-top=0.15em] { [span $pk_s_6 font-size=12 color=#e6ac3c text=" "] } }
	[box $pk_7 .btn on-click=pick7 width=16.6em visible=false] { [box] { [span $pk_n_7 font-size=18 color=#f1efe6 text=" "] [span $pk_t_7 font-size=13 color=#8b97a3 text=" "] } [box padding-top=0.15em] { [span $pk_s_7 font-size=12 color=#e6ac3c text=" "] } }
	[box $pk_8 .btn on-click=pick8 width=16.6em visible=false] { [box] { [span $pk_n_8 font-size=18 color=#f1efe6 text=" "] [span $pk_t_8 font-size=13 color=#8b97a3 text=" "] } [box padding-top=0.15em] { [span $pk_s_8 font-size=12 color=#e6ac3c text=" "] } }
	[box $pk_9 .btn on-click=pick9 width=16.6em visible=false] { [box] { [span $pk_n_9 font-size=18 color=#f1efe6 text=" "] [span $pk_t_9 font-size=13 color=#8b97a3 text=" "] } [box padding-top=0.15em] { [span $pk_s_9 font-size=12 color=#e6ac3c text=" "] } }
	[box $pk_10 .btn on-click=pick10 width=16.6em visible=false] { [box] { [span $pk_n_10 font-size=18 color=#f1efe6 text=" "] [span $pk_t_10 font-size=13 color=#8b97a3 text=" "] } [box padding-top=0.15em] { [span $pk_s_10 font-size=12 color=#e6ac3c text=" "] } }
	[box $pk_11 .btn on-click=pick11 width=16.6em visible=false] { [box] { [span $pk_n_11 font-size=18 color=#f1efe6 text=" "] [span $pk_t_11 font-size=13 color=#8b97a3 text=" "] } [box padding-top=0.15em] { [span $pk_s_11 font-size=12 color=#e6ac3c text=" "] } }
	[box $pk_12 .btn on-click=pick12 width=16.6em visible=false] { [box] { [span $pk_n_12 font-size=18 color=#f1efe6 text=" "] [span $pk_t_12 font-size=13 color=#8b97a3 text=" "] } [box padding-top=0.15em] { [span $pk_s_12 font-size=12 color=#e6ac3c text=" "] } }
	[box $pk_none visible=false padding-bottom=0.5em] { [span color=#ff7a6a text="Nobody is free."] }
	[box .btn on-click=pickcancel width=16.6em margin-top=0.6em color=#8b97a3] { CANCEL }
}

// ================= centre of the screen: why an order failed (hud.evox g_result), fades after a few seconds =================
[box $center_msg .panel position=absolute left=50% pivot-x=50% top=40% padding=1em padding-left=2em padding-right=2em visible=false] { [span $center_msg_t font-size=22 color=#ff9a80 text=" "] }

// ================= main menu (hud.evox menu*): covers everything, the game is paused while it is open =================
[box $menu position=absolute left=0 top=0 width=100% height=100% bg-image="ui/menu_grad.spr" visible=false] {
	[box position=absolute left=9em top=12em width=56em direction=column] {
		[box direction=row wrap=false font-size=96 color=#f4efe3] { [box padding-right=0.35em] { [span font="/engine/editor/fonts/Roboto-Bold.ttf" text="STILL"] } [box] { [span font="/engine/editor/fonts/Roboto-Light.ttf" text="ABOVE"] } }
		[box width=3.2em height=0.1em bg-color=#e8952a margin-top=0.2em margin-bottom=0.7em] {}
		[box direction=row wrap=false font-size=22 color=#e8952a padding-bottom=0.6em] { [box padding-right=0.9em] { [span text="O R B I T A L"] } [box] { [span text="R E F U G E"] } }
		[box width=36em padding-bottom=3.6em] { [span font-size=20 color=#9aa6b2 text="The Earth below is dead. One damaged module, two crew, and a few hours of air."] }
		[box $mn_continue .mitem on-click=menu_continue] { [span color=#6b7682 text="Continue"] }
		[box $mn_start .mitem on-click=menu_start] { [span text="Start game"] }
		[box $mn_resume .mitem on-click=menu_start visible=false] { [span text="Resume"] }
		[box $mn_new .mitem on-click=menu_new visible=false] { [span text="New game"] }
		[box .mitem on-click=menu_controls] { [span text="Controls"] }
		[box $mn_help width=40em padding-top=1.2em padding-left=1.6em visible=false direction=column font-size=18 color=#c0cad3] {
			[box width=40em padding-bottom=0.5em] { [span text="Right mouse drag: orbit the camera.   Wheel: zoom.   WASD: pan."] }
			[box width=40em padding-bottom=0.5em] { [span text="Left nav: pick STRUCTURE, EXTENSIONS, RACKS or ATTACHMENTS, click an item, then click a free port or hull slot."] }
			[box width=40em padding-bottom=0.5em] { [span text="R turns the item being placed. Esc or a right click cancels. Esc with nothing selected opens this menu."] }
			[box width=40em padding-bottom=0.5em] { [span text="Give an order: every job needs someone, and a popup asks who."] }
			[box width=40em padding-bottom=0.5em] { [span text="Space pauses. Z / X / C = 1x / 3x / 10x. B starts a reboost burn."] }
			[box width=40em padding-bottom=0.5em] { [span text="Keep the crew breathing, fed and watered, and keep the orbit up. The OBJECTIVES tab lists what is wrong."] }
		}
	}
	[box position=absolute left=7em top=96% pivot-y=100% font-size=16 color=#7a8794] { [span text="Esc: menu    Space: pause    Z X C: speed"] }
}
} // full-canvas HUD
