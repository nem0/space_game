// In-game HUD, flat dark-glass skin (sprites from the ui/*.ltct recipes). Texts, bars and visibility are driven by scripts/hud.evox through the element ids.
[style] {
	.panel { bg-image: "ui/panel.spr"; padding: 1.5em; color: #d5dbe0; }
	.panelb { bg-image: "ui/panel.spr"; padding: 1.8em; color: #d5dbe0; }
	.term { bg-image: "ui/panel_flat.spr"; padding: 1.1em; color: #9fe8c0; }
	.hd { color: #e8952a; font-size: 15; padding-bottom: 0.6em; }
	.navb { width: 9.5em; height: 2.6em; margin-bottom: 0.3em; padding-left: 1.4em; padding-top: 0.7em; font: "/engine/editor/fonts/Roboto-Bold.ttf"; font-size: 15; }
	.tab { height: 2.2em; margin-right: 0.3em; padding-top: 0.55em; align: center; font: "/engine/editor/fonts/Roboto-Bold.ttf"; font-size: 16; }
	.chip { padding-left: 0.5em; padding-right: 0.5em; direction: row; wrap: false; align-items: center; }
	.cl { font-size: 11; color: #8b97a3; }
	.cv { font-size: 19; color: #f1efe6; }
	.btn { bg-image: "ui/btn.spr"; padding: 0.55em; margin: 0.1em; align: center; color: #e3e9ee; }
	.btn:hover { bg-image: "ui/btn_h.spr"; color: #ffe2b8; }
	.btnon { bg-image: "ui/btn_on.spr"; padding: 0.55em; margin: 0.1em; align: center; color: #fff1dc; }
	.tbtn { bg-image: "ui/btn.spr"; padding: 0.3em; margin: 0.12em; }
	.tbtn:hover { bg-image: "ui/btn_h.spr"; }
	.card { bg-image: "ui/card.spr"; padding: 0.6em; margin: 0.2em; width: 11.6em; color: #dbe3ea; }
	.card:hover { bg-image: "ui/card_h.spr"; }
	.cname { color: #f1efe6; font-size: 17; padding-top: 0.2em; padding-bottom: 0.3em; }
	.cost { padding-right: 0.4em; font-size: 14; color: #9fb0bf; direction: row; wrap: false; align-items: center; }
	.cstat { font-size: 14; color: #e8952a; padding-top: 0.35em; }
	.acard { bg-image: "ui/card.spr"; padding: 0.35em; margin: 0.2em; width: 21.4em; color: #dbe3ea; }
	.acard:hover { bg-image: "ui/card_h.spr"; }
	.ccard { bg-image: "ui/card.spr"; padding: 0.3em; margin: 0.1em; width: 6.3em; color: #dbe3ea; }
	.ccard:hover { bg-image: "ui/card_h.spr"; }
	.lrow { bg-image: "ui/card.spr"; padding: 0.4em; padding-left: 0.5em; margin-bottom: 0.2em; width: 32.2em; color: #dbe3ea; }
	.lrow:hover { bg-image: "ui/card_h.spr"; }
	.lcost { padding-right: 0.8em; font-size: 14; color: #9fb0bf; direction: row; wrap: false; align-items: center; }
	.gh { font-size: 12; color: #8b97a3; padding-top: 0.5em; padding-bottom: 0.3em; }
	.stab { height: 2em; margin-right: 0.25em; padding-top: 0.45em; align: center; font: "/engine/editor/fonts/Roboto-Bold.ttf"; font-size: 14; }
	.mitem { bg-image: "ui/menu_none.spr"; padding: 0.45em; padding-left: 1.6em; margin-bottom: 0.2em; color: #dbe3ea; font-size: 32; width: 20em; }
	.mitem:hover { bg-image: "ui/menu_hover.spr"; color: #ffd9a0; }
	.acost { padding-right: 0.2em; font-size: 10; direction: row; wrap: false; align-items: center; }
	.bar { bg-color: #121a22; height: 0.4em; width: 21.4em; margin-bottom: 0.4em; }
	.ck { width: 1.3em; height: 1.3em; bg-image: "ui/btn.spr"; margin-right: 0.8em; margin-top: 0.15em; }
	.ckon { width: 1.3em; height: 1.3em; bg-image: "ui/ic_check.spr"; margin-right: 0.8em; margin-top: 0.15em; }
	.ot { color: #edf0f2; font-size: 18; }
	.os { color: #98a3ac; font-size: 15; padding-top: 0.2em; padding-bottom: 0.7em; }
	.row { font-size: 16; padding-bottom: 0.25em; }
	.toast { margin-bottom: 0.35em; }
	.tin { direction: row; wrap: false; align-items: center; padding: 0.55em; padding-left: 1em; }
	.tic { width: 2em; height: 2em; margin-right: 0.7em; }
	.ttx { width: 21em; }
	.tn { width: 19em; height: 6.6em; padding: 0.4em; }
	.tnl { bg-image: "ui/node_l.spr"; }
	.tna { bg-image: "ui/node_a.spr"; }
	.tnu { bg-image: "ui/node_u.spr"; }
	.tnx { bg-image: "ui/node_x.spr"; }
}

[box $hud width=100% height=100% font="/engine/editor/fonts/Roboto-Light.ttf" font-size=18 color=#d5dbe0] {
// ================= top bar =================
[box $topbar position=absolute left=0 top=0 width=100% height=3.6em direction=row wrap=false align-items=center bg-color=#010203f2 padding-left=1.2em padding-right=1.2em] {
	[box width=13em] {
		[box direction=row wrap=false font-size=22 color=#f0eadb] { [box padding-right=0.55em] { S T I L L } [box] { A B O V E } }
		[box direction=row wrap=false font-size=10 color=#e6ac3c padding-top=0.3em] { [box padding-right=0.7em] { O R B I T A L } [box] { R E F U G E } }
	}
	[box direction=row wrap=false grow=1 align-items=center justify-content=space-between] {
		[box .chip] { [box width=2.1em height=2.1em bg-image="ui/cut_steel.spr"] {} [box padding-left=0.55em] { [box .cl] { STEEL } [box .cv] { [span $c_steel text=" "] } } }
		[box width=0.07em height=2.4em bg-color=#1f2a36] {}
		[box .chip] { [box width=2.1em height=2.1em bg-image="ui/cut_polymers.spr"] {} [box padding-left=0.55em] { [box .cl] { POLYMERS } [box .cv] { [span $c_poly text=" "] } } }
		[box width=0.07em height=2.4em bg-color=#1f2a36] {}
		[box .chip] { [box width=2.1em height=2.1em bg-image="ui/cut_electronics.spr"] {} [box padding-left=0.55em] { [box .cl] { ELECTRONICS } [box .cv] { [span $c_elec text=" "] } } }
		[box width=0.07em height=2.4em bg-color=#1f2a36] {}
		[box .chip] { [box width=2.1em height=2.1em bg-image="ui/cut_parts.spr"] {} [box padding-left=0.55em] { [box .cl] { PARTS } [box .cv] { [span $c_parts text=" "] } } }
		[box width=0.07em height=2.4em bg-color=#1f2a36] {}
		[box .chip] { [box width=2.1em height=2.1em bg-image="ui/cut_food.spr"] {} [box padding-left=0.55em] { [box .cl] { FOOD } [box .cv] { [span $c_food text=" "] } } }
		[box width=0.07em height=2.4em bg-color=#1f2a36] {}
		[box .chip] { [box width=2.1em height=2.1em bg-image="ui/cut_water.spr"] {} [box padding-left=0.55em] { [box .cl] { WATER } [box .cv] { [span $c_water text=" "] } } }
		[box width=0.07em height=2.4em bg-color=#1f2a36] {}
		[box .chip] { [box width=2.1em height=2.1em bg-image="ui/cut_oxygen.spr"] {} [box padding-left=0.55em] { [box .cl] { OXYGEN } [box .cv] { [span $c_o2 text=" "] } } }
		[box width=0.07em height=2.4em bg-color=#1f2a36] {}
		[box .chip] { [box width=2.1em height=2.1em bg-image="ui/cut_co2.spr"] {} [box padding-left=0.55em] { [box .cl] { CO2 } [box .cv] { [span $c_co2 text=" "] } } }
		[box width=0.07em height=2.4em bg-color=#1f2a36] {}
		[box .chip] { [box width=2.1em height=2.1em bg-image="ui/cut_power.spr"] {} [box padding-left=0.55em] { [box .cl] { POWER } [box .cv] { [span $c_power text=" "] } } }
		[box width=0.07em height=2.4em bg-color=#1f2a36] {}
		[box .chip] { [box width=2.1em height=2.1em bg-image="ui/cut_altitude.spr"] {} [box padding-left=0.55em] { [box .cl] { ALTITUDE } [box .cv] { [span $c_alt text=" "] } } }
		[box width=0.07em height=2.4em bg-color=#1f2a36] {}
		[box .chip] { [box width=2.1em height=2.1em bg-image="ui/cut_crew.spr"] {} [box padding-left=0.55em] { [box .cl] { CREW } [box .cv] { [span $c_crew text=" "] } } }
		[box width=0.07em height=2.4em bg-color=#1f2a36] {}
		[box .chip] { [box width=2.1em height=2.1em bg-image="ui/cut_research.spr"] {} [box padding-left=0.55em] { [box .cl] { RESEARCH } [box .cv] { [span $c_rp text=" "] } } }
	}
	[box width=0.07em height=2.4em bg-color=#1f2a36 margin-left=0.6em] {}
	[box direction=row wrap=false align-items=center padding-left=1em] {
		[box .tbtn on-click=speed0] { [box bg-image="ui/t_pause.spr" width=1.3em height=1.3em] {} }
		[box .tbtn on-click=speed1] { [box bg-image="ui/t_play.spr" width=1.3em height=1.3em] {} }
		[box .tbtn on-click=speed2] { [box bg-image="ui/t_ff.spr" width=1.3em height=1.3em] {} }
		[box .tbtn on-click=speed3] { [box bg-image="ui/t_fff.spr" width=1.3em height=1.3em] {} }
		[box .btn on-click=menu_open margin-left=0.8em width=4.4em font-size=13] { MENU }
	}
}
[box position=absolute left=0 top=3.6em width=100% height=0.12em bg-color=#1d2733] {}

// ================= top centre: active tasks (hud.evox tasksPanel): who works on what, with progress =================
[box $tasks .panel position=absolute left=50% pivot-x=50% top=97% pivot-y=100% width=30em font-size=14 padding=0.9em direction=column visible=false] {
	[box .hd font-size=12 padding-bottom=0.4em] { T A S K S }
	[box $tk_1 width=28em padding-bottom=0.5em visible=false] { [box width=28em] { [span $tk_t_1 color=#dbe3ea text=" "] } [box width=28em height=0.25em bg-color=#0b1218 margin-top=0.2em] { [box $tk_b_1 width=0% height=0.25em bg-color=#e8952a] {} } }
	[box $tk_2 width=28em padding-bottom=0.5em visible=false] { [box width=28em] { [span $tk_t_2 color=#dbe3ea text=" "] } [box width=28em height=0.25em bg-color=#0b1218 margin-top=0.2em] { [box $tk_b_2 width=0% height=0.25em bg-color=#e8952a] {} } }
	[box $tk_3 width=28em padding-bottom=0.5em visible=false] { [box width=28em] { [span $tk_t_3 color=#dbe3ea text=" "] } [box width=28em height=0.25em bg-color=#0b1218 margin-top=0.2em] { [box $tk_b_3 width=0% height=0.25em bg-color=#e8952a] {} } }
	[box $tk_4 width=28em padding-bottom=0.5em visible=false] { [box width=28em] { [span $tk_t_4 color=#dbe3ea text=" "] } [box width=28em height=0.25em bg-color=#0b1218 margin-top=0.2em] { [box $tk_b_4 width=0% height=0.25em bg-color=#e8952a] {} } }
	[box $tk_5 width=28em padding-bottom=0.5em visible=false] { [box width=28em] { [span $tk_t_5 color=#dbe3ea text=" "] } [box width=28em height=0.25em bg-color=#0b1218 margin-top=0.2em] { [box $tk_b_5 width=0% height=0.25em bg-color=#e8952a] {} } }
	[box $tk_6 width=28em padding-bottom=0.5em visible=false] { [box width=28em] { [span $tk_t_6 color=#dbe3ea text=" "] } [box width=28em height=0.25em bg-color=#0b1218 margin-top=0.2em] { [box $tk_b_6 width=0% height=0.25em bg-color=#e8952a] {} } }
	[box $tk_7 width=28em padding-bottom=0.5em visible=false] { [box width=28em] { [span $tk_t_7 color=#dbe3ea text=" "] } [box width=28em height=0.25em bg-color=#0b1218 margin-top=0.2em] { [box $tk_b_7 width=0% height=0.25em bg-color=#e8952a] {} } }
	[box $tk_8 width=28em padding-bottom=0.5em visible=false] { [box width=28em] { [span $tk_t_8 color=#dbe3ea text=" "] } [box width=28em height=0.25em bg-color=#0b1218 margin-top=0.2em] { [box $tk_b_8 width=0% height=0.25em bg-color=#e8952a] {} } }
}

// ================= left: navigation, objectives =================
[box $nav position=absolute left=0.8em top=4.5em direction=column] {
	[box $nav_0 .navb on-click=nav0 bg-image="ui/navb.spr"] { [span color=#c6d0da text="STRUCTURE"] }
	[box $nava_0 .navb on-click=nav0 bg-image="ui/navb_a.spr" visible=false] { [span color=#ffffff text="STRUCTURE"] }
	[box $nav_1 .navb on-click=nav1 bg-image="ui/navb.spr"] { [span color=#c6d0da text="EXTENSIONS"] }
	[box $nava_1 .navb on-click=nav1 bg-image="ui/navb_a.spr" visible=false] { [span color=#ffffff text="EXTENSIONS"] }
	[box $nav_2 .navb on-click=nav2 bg-image="ui/navb.spr"] { [span color=#c6d0da text="RACKS"] }
	[box $nava_2 .navb on-click=nav2 bg-image="ui/navb_a.spr" visible=false] { [span color=#ffffff text="RACKS"] }
	[box $nav_3 .navb on-click=nav3 bg-image="ui/navb.spr"] { [span color=#c6d0da text="ATTACHMENTS"] }
	[box $nava_3 .navb on-click=nav3 bg-image="ui/navb_a.spr" visible=false] { [span color=#ffffff text="ATTACHMENTS"] }
	[box $nav_4 .navb on-click=nav4 margin-top=0.9em bg-image="ui/navb.spr"] { [span color=#c6d0da text="CREW"] }
	[box $nava_4 .navb on-click=nav4 margin-top=0.9em bg-image="ui/navb_a.spr" visible=false] { [span color=#ffffff text="CREW"] }
	[box $nav_5 .navb on-click=nav5 bg-image="ui/navb.spr"] { [span color=#c6d0da text="RESOURCES"] }
	[box $nava_5 .navb on-click=nav5 bg-image="ui/navb_a.spr" visible=false] { [span color=#ffffff text="RESOURCES"] }
	[box $nav_6 .navb on-click=nav6 bg-image="ui/navb.spr"] { [span color=#c6d0da text="RESEARCH"] }
	[box $nava_6 .navb on-click=nav6 bg-image="ui/navb_a.spr" visible=false] { [span color=#ffffff text="RESEARCH"] }
	[box $nav_7 .navb on-click=nav7 bg-image="ui/navb.spr"] { [span color=#c6d0da text="OBJECTIVES"] }
	[box $nava_7 .navb on-click=nav7 bg-image="ui/navb_a.spr" visible=false] { [span color=#ffffff text="OBJECTIVES"] }
}

// ================= side panel next to the navigation (one per nav item) =================
[box $p_crew .panel position=absolute left=12.6em top=4.5em width=51em visible=false font-size=16 direction=row wrap=false] {
[box width=47em direction=column padding-right=1.5em] {
	[box .hd] { C R E W }
	[box .row width=44em] { [span $cr_1 text=" "] }
	[box .row width=44em] { [span $cr_2 text=" "] }
	[box .row width=44em] { [span $cr_3 text=" "] }
	[box direction=row wrap=false padding-top=0.4em padding-bottom=0.2em font-size=14] { [box width=6.4em] { [span color=#8f9ba4 font-size=12 text="NAME"] } [box width=5.4em] { [span color=#8f9ba4 font-size=12 text="STATUS"] } [box width=2.3em] { [span color=#8f9ba4 font-size=12 text="STR"] } [box width=2.3em] { [span color=#8f9ba4 font-size=12 text="INT"] } [box width=2.3em] { [span color=#8f9ba4 font-size=12 text="DEX"] } [box width=2.3em] { [span color=#8f9ba4 font-size=12 text="END"] } [box width=3.2em] { [span color=#8f9ba4 font-size=12 text="FIT"] } [box padding-left=0.6em] { [span color=#8f9ba4 font-size=12 text="DOING"] } }
	[box $crr_1 on-click=crsel_1 direction=row wrap=false visible=false padding-bottom=0.15em font-size=14] {
		[box width=6.4em] { [span $crn_1 color=#f1efe6 text=" "] [span $crns_1 color=#e6ac3c text=" " visible=false] [span $crnd_1 color=#6b747b text=" " visible=false] }
		[box width=5.4em] { [span $crs_1 color=#9fe8a8 text=" "] [span $crsa_1 color=#e6ac3c text=" " visible=false] [span $crsd_1 color=#6b747b text=" " visible=false] }
		[box width=2.3em] { [span $crv0_1 color=#8f9ba4 text=" "] [span $crvh0_1 color=#e6ac3c text=" " visible=false] }
		[box width=2.3em] { [span $crv1_1 color=#8f9ba4 text=" "] [span $crvh1_1 color=#e6ac3c text=" " visible=false] }
		[box width=2.3em] { [span $crv2_1 color=#8f9ba4 text=" "] [span $crvh2_1 color=#e6ac3c text=" " visible=false] }
		[box width=2.3em] { [span $crv3_1 color=#8f9ba4 text=" "] [span $crvh3_1 color=#e6ac3c text=" " visible=false] }
		[box width=3.2em] { [span $crf_1 color=#9fe8a8 text=" "] [span $crfl_1 color=#ff7a6a text=" " visible=false] }
		[box width=0.6em] {}
		[box width=21em] { [span $crd_1 color=#c9d1d7 text=" "] }
	}
	[box $crr_2 on-click=crsel_2 direction=row wrap=false visible=false padding-bottom=0.15em font-size=14] {
		[box width=6.4em] { [span $crn_2 color=#f1efe6 text=" "] [span $crns_2 color=#e6ac3c text=" " visible=false] [span $crnd_2 color=#6b747b text=" " visible=false] }
		[box width=5.4em] { [span $crs_2 color=#9fe8a8 text=" "] [span $crsa_2 color=#e6ac3c text=" " visible=false] [span $crsd_2 color=#6b747b text=" " visible=false] }
		[box width=2.3em] { [span $crv0_2 color=#8f9ba4 text=" "] [span $crvh0_2 color=#e6ac3c text=" " visible=false] }
		[box width=2.3em] { [span $crv1_2 color=#8f9ba4 text=" "] [span $crvh1_2 color=#e6ac3c text=" " visible=false] }
		[box width=2.3em] { [span $crv2_2 color=#8f9ba4 text=" "] [span $crvh2_2 color=#e6ac3c text=" " visible=false] }
		[box width=2.3em] { [span $crv3_2 color=#8f9ba4 text=" "] [span $crvh3_2 color=#e6ac3c text=" " visible=false] }
		[box width=3.2em] { [span $crf_2 color=#9fe8a8 text=" "] [span $crfl_2 color=#ff7a6a text=" " visible=false] }
		[box width=0.6em] {}
		[box width=21em] { [span $crd_2 color=#c9d1d7 text=" "] }
	}
	[box $crr_3 on-click=crsel_3 direction=row wrap=false visible=false padding-bottom=0.15em font-size=14] {
		[box width=6.4em] { [span $crn_3 color=#f1efe6 text=" "] [span $crns_3 color=#e6ac3c text=" " visible=false] [span $crnd_3 color=#6b747b text=" " visible=false] }
		[box width=5.4em] { [span $crs_3 color=#9fe8a8 text=" "] [span $crsa_3 color=#e6ac3c text=" " visible=false] [span $crsd_3 color=#6b747b text=" " visible=false] }
		[box width=2.3em] { [span $crv0_3 color=#8f9ba4 text=" "] [span $crvh0_3 color=#e6ac3c text=" " visible=false] }
		[box width=2.3em] { [span $crv1_3 color=#8f9ba4 text=" "] [span $crvh1_3 color=#e6ac3c text=" " visible=false] }
		[box width=2.3em] { [span $crv2_3 color=#8f9ba4 text=" "] [span $crvh2_3 color=#e6ac3c text=" " visible=false] }
		[box width=2.3em] { [span $crv3_3 color=#8f9ba4 text=" "] [span $crvh3_3 color=#e6ac3c text=" " visible=false] }
		[box width=3.2em] { [span $crf_3 color=#9fe8a8 text=" "] [span $crfl_3 color=#ff7a6a text=" " visible=false] }
		[box width=0.6em] {}
		[box width=21em] { [span $crd_3 color=#c9d1d7 text=" "] }
	}
	[box $crr_4 on-click=crsel_4 direction=row wrap=false visible=false padding-bottom=0.15em font-size=14] {
		[box width=6.4em] { [span $crn_4 color=#f1efe6 text=" "] [span $crns_4 color=#e6ac3c text=" " visible=false] [span $crnd_4 color=#6b747b text=" " visible=false] }
		[box width=5.4em] { [span $crs_4 color=#9fe8a8 text=" "] [span $crsa_4 color=#e6ac3c text=" " visible=false] [span $crsd_4 color=#6b747b text=" " visible=false] }
		[box width=2.3em] { [span $crv0_4 color=#8f9ba4 text=" "] [span $crvh0_4 color=#e6ac3c text=" " visible=false] }
		[box width=2.3em] { [span $crv1_4 color=#8f9ba4 text=" "] [span $crvh1_4 color=#e6ac3c text=" " visible=false] }
		[box width=2.3em] { [span $crv2_4 color=#8f9ba4 text=" "] [span $crvh2_4 color=#e6ac3c text=" " visible=false] }
		[box width=2.3em] { [span $crv3_4 color=#8f9ba4 text=" "] [span $crvh3_4 color=#e6ac3c text=" " visible=false] }
		[box width=3.2em] { [span $crf_4 color=#9fe8a8 text=" "] [span $crfl_4 color=#ff7a6a text=" " visible=false] }
		[box width=0.6em] {}
		[box width=21em] { [span $crd_4 color=#c9d1d7 text=" "] }
	}
	[box $crr_5 on-click=crsel_5 direction=row wrap=false visible=false padding-bottom=0.15em font-size=14] {
		[box width=6.4em] { [span $crn_5 color=#f1efe6 text=" "] [span $crns_5 color=#e6ac3c text=" " visible=false] [span $crnd_5 color=#6b747b text=" " visible=false] }
