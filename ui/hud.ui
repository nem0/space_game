// ================= top right: alerts and log =================
[box $toasts position=absolute left=99% pivot-x=100% top=4.5em width=25em direction=column font-size=15] {
	[box $al_o2 .toast bg-image="ui/toast_red.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_low_oxygen.spr"] {} [box .ttx] { [span color=#f3e4e0 text="Low oxygen - build life support"] } } }
	[box $al_co2 .toast bg-image="ui/toast_red.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_low_oxygen.spr"] {} [box .ttx] { [span color=#f3e4e0 text="CO2 too high - build scrubbers or plants"] } } }
	[box $al_food .toast bg-image="ui/toast_red.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_low_food.spr"] {} [box .ttx] { [span color=#f3e4e0 text="Low food - build hydroponics"] } } }
	[box $al_power .toast bg-image="ui/toast_red.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_no_power.spr"] {} [box .ttx] { [span color=#f3e4e0 text="Power failure - output reduced"] } } }
	[box $al_heat .toast bg-image="ui/toast_amber.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_repair.spr"] {} [box .ttx] { [span color=#f3e4e0 text="Overheating - add radiators"] } } }
	[box $al_water .toast bg-image="ui/toast_red.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_low_oxygen.spr"] {} [box .ttx] { [span color=#f3e4e0 text="Low water - recycle it, fetch ice"] } } }
	[box $al_hp .toast bg-image="ui/toast_amber.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_repair.spr"] {} [box .ttx] { [span $al_hp_t color=#efe6cc text=" "] } } }
	[box $al_orbit .toast bg-image="ui/toast_red.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_no_power.spr"] {} [box .ttx] { [span $al_orbit_t color=#f3e4e0 text=" "] } } }
	[box $al_fit .toast bg-image="ui/toast_amber.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_crew.spr"] {} [box .ttx] { [span $al_fit_t color=#efe6cc text=" "] } } }
	[box $al_rescue .toast bg-image="ui/toast_blue.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_crew.spr"] {} [box .ttx] { [span $al_rescue_t color=#d9e6f0 text=" "] } } }
	[box $lg_2 .toast bg-image="ui/toast_dark.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_ok.spr"] {} [box .ttx] { [span $l_2 color=#8fa8bf text=" "] } } }
	[box $lg_1 .toast bg-image="ui/toast_dark.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_ok.spr"] {} [box .ttx] { [span $l_1 color=#b4cbe0 text=" "] } } }
	[box $lg_0 .toast bg-image="ui/toast_green.spr" visible=false] { [box .tin] { [box .tic bg-image="ui/alert_ok.spr"] {} [box .ttx] { [span $l_0 color=#ffffff text=" "] } } }
}

