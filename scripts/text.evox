// Tiny fixed-size text buffer: UI spans take one string, so lines are assembled here first.


struct Buf {
	data : [200]u8;
	len : i32;
}

fn clear(b : *Buf) : void {
	b.len = 0;
}

fn put(b : *Buf, s : []const u8) : void {
	for c in s {
		if b.len < 200 {
			b.data[b.len] = c;
			b.len += 1;
		}
	}
}

fn putByte(b : *Buf, c : u8) : void {
	if b.len < 200 {
		b.data[b.len] = c;
		b.len += 1;
	}
}

// digits are written straight into the buffer (core:string's integerToString returns a slice into its own stack frame)
fn putInt(b : *Buf, v : i32) : void {
	var n : u64 = v as u64;
	if v < 0 {
		putByte(b, '-');
		n = (0 as u64) - (v as u64);
	}
	var tmp : [12]u8 = undefined;
	var count : i32 = 0;
	if n == 0 {
		tmp[0] = '0';
		count = 1;
	}
	while n > 0 {
		tmp[count] = ('0' + (n % 10)) as u8;
		count += 1;
		n /= 10;
	}
	var i : i32 = count - 1;
	while i >= 0 {
		putByte(b, tmp[i]);
		i -= 1;
	}
}

// one decimal place
fn putF1(b : *Buf, v : f32) : void {
	var t : i32 = (v * 10.0 + 0.5) as i32;
	if v < 0.0 { t = (v * 10.0 - 0.5) as i32; }
	if t < 0 { put(b, "-"); t = -t; }
	putInt(b, t / 10);
	put(b, ".");
	putInt(b, t % 10);
}

fn view(b : *Buf) : []const u8 {
	return b.data[0:b.len];
}

// integer with a space between each group of three digits: 12 500
fn putGrouped(b : *Buf, v : i32) : void {
	var n = v;
	if n < 0 { putByte(b, '-'); n = -n; }
	var tmp : [16]u8 = undefined;
	var count : i32 = 0;
	var digits : i32 = 0;
	if n == 0 { tmp[0] = '0'; count = 1; }
	while n > 0 {
		if digits > 0 and digits % 3 == 0 { tmp[count] = ' '; count += 1; }
		tmp[count] = ('0' + (n % 10)) as u8;
		count += 1; digits += 1;
		n /= 10;
	}
	var i : i32 = count - 1;
	while i >= 0 { putByte(b, tmp[i]); i -= 1; }
}
