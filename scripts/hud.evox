// Heads-up display on the engine's in-game UI (ui/hud.ui).
// Texts, bar widths and visibility are pushed into elements by id; clicks and hovers come back as UI events.
import "core:world"
import "core:log"
import "core:ui/module"
import "core:ui/document"
import "core:ui/element"
import "core:ui/event"
import "core:ui/eventtype"
import "scripts/defs" as defs
import "scripts/config" as cfg
import "scripts/state" as st
import "scripts/text" as text
import "scripts/sim" as sim
import "scripts/build" as build
import "scripts/orbit" as orbit
import "scripts/objectives" as obj
import "scripts/save" as save
import "core:random" as rnd

var g_timer : f32 = 0.0;          // seconds until the next refresh (setText re-lays out the document, so texts are refreshed at ~4 Hz)
var g_result : []const u8 = "";   // last build failure reason, shown in the centre of the screen for a few seconds
var g_result_t : f32 = 0.0;       // seconds it is still shown
var g_hover : i32 = 0;            // kind index (1..12) of the build card under the cursor, 0 = none
var g_warned : bool = false;
var g_seen : bool = false;
var g_nav : i32 = 0;              // left navigation (-1 none, a click on the open item closes it): 0..3 build list (structure, extensions, racks, attachments = st.tab), 4 crew, 5 resources, 6 research, 7 objectives and missions
var g_help : bool = false;         // the controls text of the main menu is shown
var g_ui_down : bool = false;       // a mouse press landed on the HUD this frame (set in handle, read and cleared by main via uiDown)

// opens navigation item i, or closes it when it is already open
fn navToggle(i : i32) : void {
	g_nav = g_nav == i ? -1 : i;
	if i >= 0 and i < 4 { st.tab = i; }
}

fn init(world : World) : void {
	g_timer = 0.0;
	g_result = "";
	g_hover = 0;
	g_nav = 7;   // the game opens on the objectives
	st.tab = 0;
	if world.ui() == null { logInfo("[game] hud.init: NO ui module in this world"); } else { logInfo("[game] hud.init: loading ui/hud.ui"); }
	if const ui = world.ui() {
		ui.load("ui/hud.ui");
		ui.getSystem().enableCursor(true);
	}
}

// ---- element helpers (ids are built as prefix + number where the markup repeats, e.g. cname_3) ---------------------------------------

fn put(doc : Document, id : []const u8, b : *text.Buf) : void {
	if const e = doc.getElementByID(id) { e.setText(text.view(b)); }
	text.clear(b);
}

fn show(doc : Document, id : []const u8, visible : bool) : void {
	if const e = doc.getElementByID(id) { e.setVisible(visible); }
}

fn putN(doc : Document, prefix : []const u8, n : i32, b : *text.Buf) : void {
	var k : text.Buf = undefined;
	text.clear(&k);
	text.put(&k, prefix);
	text.putInt(&k, n);
	if const e = doc.getElementByID(text.view(&k)) { e.setText(text.view(b)); }
	text.clear(b);
}

fn showN(doc : Document, prefix : []const u8, n : i32, visible : bool) : void {
	var k : text.Buf = undefined;
	text.clear(&k);
	text.put(&k, prefix);
	text.putInt(&k, n);
	if const e = doc.getElementByID(text.view(&k)) { e.setVisible(visible); }
}

fn bar(doc : Document, id : []const u8, fraction : f32) : void {
	var pct = fraction * 100.0;
	if pct < 0.0 { pct = 0.0; }
	if pct > 100.0 { pct = 100.0; }
	var b : text.Buf = undefined;
	text.clear(&b);
	text.putInt(&b, pct as i32);
	text.put(&b, "%");
	if const e = doc.getElementByID(id) { e.setWidth(text.view(&b)); }
}

fn ratio(v : f32, cap : f32) : f32 {
	if cap < 0.001 { return 0.0; }
	return v / cap;
}

// build card children are named <prefix>_<kind index>; returns the kind index for any such id, 0 otherwise
fn hoverIndex(id : []const u8) : i32 {
	var us : i32 = -1;
	for i, c in id { if c == '_' { us = i as i32; } }
	if us < 1 or us + 1 >= id.length as i32 { return 0; }
	var n : i32 = 0;
	for i in (us + 1)..(id.length as i32) {
		const c = id[i];
		if c < '0' or c > '9' { return 0; }
		n = n * 10 + (c - '0') as i32;
	}
	match id[0:us] {
		case "rcard", "rthumb", "rtxt", "rnb", "rname", "reff", "rcost", "rbs", "rbe", "rbp", "rbm", "ris", "rie", "rip", "rim", "rs", "re", "rp", "rm", "rsb", "rst":
			if n >= 1 and n <= cfg.RACK_COUNT { return 200 + n; }
		case "acard", "athumb", "atxt", "anb", "aname", "aeff", "acost", "abs", "abe", "abp", "abm", "ais", "aie", "aip", "aim", "as", "ae", "ap", "am", "asb", "ast":
			if n >= 1 and n <= cfg.ATTACH_COUNT { return 100 + n; }
		case "card", "cthumb", "cnb", "cname", "ccost", "cbs", "cbe", "cbp", "cbm", "cis", "cie", "cip", "cim", "cs", "ce", "cp", "cm", "csb", "cst":
			if n >= 1 and n <= 12 { return n; }
		case:
	}
	return 0;
}

fn logId(i : i32) : []const u8 {
	match i {
		case 0: return "l_0";
		case 1: return "l_1";
		case: return "l_2";
	}
	return "l_2";
}

fn logRowId(i : i32) : []const u8 {
	match i {
		case 0: return "lg_0";
		case 1: return "lg_1";
		case: return "lg_2";
	}
	return "lg_2";
}

// build list categories: 0 structure (hulls, junction, docking hub), 1 extensions (wings, gas storage: they bolt onto panel mounts), 2 racks, 3 attachments
comptime TAB_RACKS = 2;
comptime TAB_ATTACH = 3;

fn tabOf(kind : defs.ModuleKind) : i32 {
	match kind {
		case .SolarWing, .RadiatorWing, .GasStorage: return 1;
		case: return 0;
	}
	return 0;
}

// what a hull is used for, after its dominant racks (the hull's dressing theme)
fn themeName(theme : i32) : []const u8 {
	match theme {
		case 1: return "habitat";
		case 2: return "farm";
		case 3: return "lab";
		case 4: return "medical";
		case 5: return "machinery";
		case 6: return "storage";
		case:
	}
	return "empty";
}

fn blurb(kind : defs.ModuleKind) : []const u8 {
	match kind {
		case .Central: return "The aging core of the station.";
		case .SmallHull: return "Empty pressurised hull with 4 rack slots. Fit racks to give it a use.";
		case .Hull: return "Empty pressurised hull with 6 rack slots. Fit racks to give it a use.";
		case .LargeHull: return "Empty pressurised hull with 10 rack slots; takes greenhouse beds.";
		case .Junction: return "Four docking ports and two panel mounts for wings.";
		case .SolarWing: return "Solar panel wing. Needs a junction panel mount.";
		case .RadiatorWing: return "Radiator wing rejects waste heat. Needs a panel mount.";
		case .GasStorage: return "External tanks store extra oxygen. Needs a panel mount.";
		case .DockingHub: return "Berths one shuttle for missions (build it from the module panel).";
	}
	return "";
}

fn effectText(b : *text.Buf, d : defs.ModuleDef) : void {
	if d.crew > 0 { text.put(b, " +"); text.putInt(b, d.crew); text.put(b, " berths"); }
	if d.o2 > 0.0 { text.put(b, " +"); text.putGrouped(b, (d.o2 * cfg.MINUTES_PER_DAY) as i32); text.put(b, " L O2/day"); }
	if d.food > 0.0 { text.put(b, " +"); text.putGrouped(b, d.food as i32); text.put(b, " kcal/day"); }
	if d.research > 0.0 { text.put(b, " +"); text.putF1(b, d.research); text.put(b, " RP/h"); }
	if d.power > 0.0 { text.put(b, " +"); text.putF1(b, d.power); text.put(b, " kW"); }
	if d.power < 0.0 { text.put(b, " "); text.putF1(b, d.power); text.put(b, " kW"); }
	if d.battery > 0.0 { text.put(b, " stores "); text.putF1(b, d.battery); text.put(b, " kWh"); }
	if d.cooling > 0.0 { text.put(b, " cools "); text.putF1(b, d.cooling); text.put(b, " kW"); }
	if d.co2_scrub > 0.0 { text.put(b, " removes "); text.putGrouped(b, (d.co2_scrub * cfg.MINUTES_PER_DAY) as i32); text.put(b, " L CO2/day"); }
	if d.mixed_store > 0.0 { text.put(b, " +"); text.putGrouped(b, d.mixed_store as i32); text.put(b, " kg cargo hold"); }
	if d.fuel_store > 0.0 { text.put(b, " +"); text.putGrouped(b, d.fuel_store as i32); text.put(b, " kg fuel tanks"); }
	if d.o2_store > 0.0 and d.o2 <= 0.0 { text.put(b, " +"); text.putGrouped(b, d.o2_store as i32); text.put(b, " L O2 storage"); }
	if d.food_store > 0.0 { text.put(b, " +"); text.putGrouped(b, d.food_store as i32); text.put(b, " kcal food storage"); }
}

fn hasModule(kind : defs.ModuleKind) : bool {
	for i in 0..st.module_count { if st.modules[i].kind == kind { return true; } }
	return false;
}

// ---- resources panel -------------------------------------------------------------------------------------------------------------------
// one row per resource (ids rs_<cell>_<row>, rows as in ui/hud.ui): stock (+ fill bar), income, use, net rate and a status

// a duration in game minutes as "45 min", "7.5 h" or "2.3 days"
fn putTime(b : *text.Buf, minutes : f32) : void {
	if minutes < 60.0 { text.putInt(b, minutes as i32); text.put(b, " min"); }
	else if minutes < 2.0 * cfg.MINUTES_PER_DAY { text.putF1(b, minutes / 60.0); text.put(b, " h"); }
	else { text.putF1(b, minutes / cfg.MINUTES_PER_DAY); text.put(b, " days"); }
}

// food amounts are thousands of kcal: grouped whole numbers
fn putKcal(b : *text.Buf, v : f32, plus : bool) : void {
	if v > 0.5 and plus { text.put(b, "+"); }
	text.putGrouped(b, v as i32); text.put(b, " kcal/day");
}

fn kcalNetCell(doc : Document, r : i32, v : f32, b : *text.Buf) : void {
	const neg = v <= -0.5;
	putKcal(b, v, true);
	putN(doc, neg ? "rs_nm_" : "rs_np_", r, b);
	showN(doc, "rs_np_", r, not neg);
	showN(doc, "rs_nm_", r, neg);
}

// litres per day from a per-minute rate: "+2 360 L/day"
fn putLday(b : *text.Buf, per_min : f32, plus : bool) : void {
	const v = per_min * cfg.MINUTES_PER_DAY;
	if v > 0.5 and plus { text.put(b, "+"); }
	text.putGrouped(b, v as i32); text.put(b, " L/day");
}

fn lNetCell(doc : Document, r : i32, per_min : f32, bad_when_positive : bool, b : *text.Buf) : void {
	const v = per_min * cfg.MINUTES_PER_DAY;
	const bad = bad_when_positive ? v > 0.5 : v < -0.5;
	putLday(b, per_min, true);
	putN(doc, bad ? "rs_nm_" : "rs_np_", r, b);
	showN(doc, "rs_np_", r, not bad);
	showN(doc, "rs_nm_", r, bad);
}

// an amount leaving a stock: "-2.5 kW", or "0"
fn putOut(b : *text.Buf, v : f32) : void {
	if v < 0.05 { text.put(b, "0"); return; }
	text.put(b, "-"); text.putF1(b, v);
}

fn putSigned(b : *text.Buf, v : f32) : void {
	if v >= 0.05 { text.put(b, "+"); }
	if v > -0.05 and v < 0.05 { text.put(b, "0"); return; }
	text.putF1(b, v);
}

// net cell: green when not negative, red when negative
fn netCell(doc : Document, r : i32, v : f32, unit : []const u8, b : *text.Buf) : void {
	const neg = v <= -0.05;
	putSigned(b, v); text.put(b, unit);
	putN(doc, neg ? "rs_nm_" : "rs_np_", r, b);
	showN(doc, "rs_np_", r, not neg);
	showN(doc, "rs_nm_", r, neg);
}

// status cell: grey, or red when warn
fn statusCell(doc : Document, r : i32, warn : bool, b : *text.Buf) : void {
	putN(doc, warn ? "rs_sw_" : "rs_st_", r, b);
	showN(doc, "rs_st_", r, not warn);
	showN(doc, "rs_sw_", r, warn);
}

fn cell(doc : Document, prefix : []const u8, r : i32, s : []const u8, b : *text.Buf) : void {
	text.put(b, s);
	putN(doc, prefix, r, b);
}

fn barN(doc : Document, r : i32, fraction : f32) : void {
	var k : text.Buf = undefined;
	text.clear(&k); text.put(&k, "rs_b_"); text.putInt(&k, r);
	bar(doc, text.view(&k), fraction);
}

// a stock with a capacity: how long until it runs out or fills up at the current net rate (per minute)
fn stockStatus(doc : Document, r : i32, stock : f32, cap : f32, net_per_min : f32, warn_minutes : f32, b : *text.Buf) : void {
	if net_per_min < -0.002 {
		const left = stock / (-net_per_min);
		if stock <= 0.01 { text.put(b, "EMPTY"); } else { text.put(b, "empty in "); putTime(b, left); }
		statusCell(doc, r, left < warn_minutes, b);
	} else if net_per_min > 0.0001 and stock < cap - 0.01 {
		text.put(b, "full in "); putTime(b, (cap - stock) / net_per_min);
		statusCell(doc, r, false, b);
	} else {
		text.put(b, stock >= cap - 0.01 ? "full" : "stable");
		statusCell(doc, r, false, b);
	}
}

// game minutes until the decaying orbit reaches `altitude`, stepping the drag model (the rate grows as it sinks)
fn minutesUntilAltitude(altitude : f32) : f32 {
	var alt = st.res.altitude;
	var minutes : f32 = 0.0;
	const step : f32 = 30.0;
	while alt > altitude and minutes < 60.0 * cfg.MINUTES_PER_DAY {
		alt -= sim.decayRate(alt) * step / cfg.MINUTES_PER_DAY;
		minutes += step;
	}
	return minutes;
}

// "Cost: 40 steel, 10 electronics, ..." (zero lines left out) for the build tooltip
fn putCostLine(b : *text.Buf, steel : i32, electronics : i32, polymers : i32, parts : i32) : void {
	text.put(b, "Cost:");
	if steel > 0 { text.put(b, " "); text.putInt(b, steel); text.put(b, " steel"); }
	if electronics > 0 { text.put(b, "  "); text.putInt(b, electronics); text.put(b, " electronics"); }
	if polymers > 0 { text.put(b, "  "); text.putInt(b, polymers); text.put(b, " polymers"); }
	if parts > 0 { text.put(b, "  "); text.putInt(b, parts); text.put(b, " machine parts"); }
}

// kg of propellant a burn to the reboost target needs now
fn reboostCost() : f32 {
	const km = cfg.BOOST_TARGET_KM - st.res.altitude;
	return km > 0.0 ? km * st.tot.boost_fuel_per_km : 0.0;
}

// ---- selected module panel ------------------------------------------------------------------------------------------------------------

var g_mi_line : i32 = 0;

fn miLine(doc : Document, b : *text.Buf) : void {
	g_mi_line += 1;
	if g_mi_line > 12 { text.clear(b); return; }
	putN(doc, "mi_l", g_mi_line, b);
	showN(doc, "mi_r", g_mi_line, true);
}

// "label: now / full unit" for a production value that scales with HP
fn miProd(doc : Document, label : []const u8, full : f32, hp : f32, unit : []const u8, b : *text.Buf) : void {
	if full <= 0.0 { return; }
	text.put(b, label); text.put(b, ": ");
	if full >= 1000.0 { text.putGrouped(b, (full * hp) as i32); text.put(b, " of "); text.putGrouped(b, full as i32); }
	else { text.putF1(b, full * hp); text.put(b, " of "); text.putF1(b, full); }
	text.put(b, unit);
	miLine(doc, b);
}

fn attachPanel(doc : Document) : void {
	const ai = st.selected_attach;
	var b : text.Buf = undefined;
	text.clear(&b);
	const a = st.attachments[ai];
	const s = cfg.attachStats(cfg.attachKind(a.kind));
	const hp = a.hp;
	text.put(&b, s.name); put(doc, "mi_title", &b);
	if hp <= 0.0 { text.put(&b, "OFFLINE - 0% HP, repair to restart"); }
	else { text.put(&b, "Condition "); text.putInt(&b, (hp * 100.0 + 0.5) as i32); text.put(&b, "%, output x"); text.putF1(&b, hp); }
	put(doc, hp < cfg.HP_WARN ? "mi_hp_bad" : "mi_hp", &b);
	show(doc, "mi_hp", hp >= cfg.HP_WARN);
	show(doc, "mi_hp_bad", hp < cfg.HP_WARN);
	bar(doc, "mi_bar", hp);
	g_mi_line = 0;
	for k in 1..13 { showN(doc, "mi_r", k, false); }
	taskLine(doc, a.task, a.task_left, a.task_total, a.worker);
	text.put(&b, "On: "); text.put(&b, defs.getDef(st.modules[a.host].kind).name); miLine(doc, &b);
	text.put(&b, s.effect); miLine(doc, &b);
	miProd(doc, "Power", s.power, hp, " kW", &b);
	if s.power < 0.0 { text.put(&b, "Power draw: "); text.putF1(&b, hp <= 0.0 ? 0.0 : -s.power); text.put(&b, " kW"); miLine(doc, &b); }
	miProd(doc, "Cooling", s.cooling, hp, " kW", &b);
	miProd(doc, "CO2 removal", s.co2_scrub * cfg.MINUTES_PER_DAY, hp, " L/day", &b);
	text.put(&b, "Mass "); text.putF1(&b, s.mass); text.put(&b, " t"); miLine(doc, &b);
	var steel : f32 = 0.0;
	var poly : f32 = 0.0;
	sim.attachRepairCost(ai, &steel, &poly);
	if steel < 0.05 and poly < 0.05 { text.put(&b, "In full repair"); }
	else { text.put(&b, "Repair: "); text.putF1(&b, steel); text.put(&b, " kg steel, "); text.putF1(&b, poly); text.put(&b, " kg polymers"); }
	put(doc, "mi_repair", &b);
	text.put(&b, "Dismantle (+"); text.putInt(&b, (cfg.ATTACH_REFUND * 100.0) as i32); text.put(&b, "% materials)"); put(doc, "mi_dis_t", &b);
}


fn rackCards(doc : Document) : void {
	var b : text.Buf = undefined;
	text.clear(&b);
	show(doc, "rrows", st.tab == TAB_RACKS);
	for i in 1..(cfg.RACK_COUNT + 1) {
		const visible = st.tab == TAB_RACKS;
		showN(doc, "rcard_", i, visible);
		if not visible { continue; }
		const s = cfg.rackStats(cfg.rackKind(i));
		text.put(&b, s.name); putN(doc, "rname_", i, &b);
		text.put(&b, s.effect); putN(doc, "reff_", i, &b);
		text.put(&b, " "); text.putInt(&b, s.steel); putN(doc, "rs_", i, &b);
		text.put(&b, " "); text.putInt(&b, s.electronics); putN(doc, "re_", i, &b);
		text.put(&b, " "); text.putInt(&b, s.polymers); putN(doc, "rp_", i, &b);
		text.put(&b, " "); text.putInt(&b, s.parts); text.put(&b, " kg"); putN(doc, "rm_", i, &b);
		if not build.rackUnlocked(s) { text.put(&b, "locked"); }
		else if not build.canAffordRack(s) { text.put(&b, "need materials"); }
		else if st.build_rack == i { text.put(&b, "click a module"); }
		else { text.put(&b, " "); }
		putN(doc, "rst_", i, &b);
	}
}

fn attachCards(doc : Document) : void {
	var b : text.Buf = undefined;
	text.clear(&b);
	show(doc, "arows", st.tab == TAB_ATTACH);
	for i in 1..(cfg.ATTACH_COUNT + 1) {
		const visible = st.tab == TAB_ATTACH;
		showN(doc, "acard_", i, visible);
		if not visible { continue; }
		const s = cfg.attachStats(cfg.attachKind(i));
		text.put(&b, s.name); putN(doc, "aname_", i, &b);
		text.put(&b, s.effect); putN(doc, "aeff_", i, &b);
		text.put(&b, " "); text.putInt(&b, s.steel); putN(doc, "as_", i, &b);
		text.put(&b, " "); text.putInt(&b, s.electronics); putN(doc, "ae_", i, &b);
		text.put(&b, " "); text.putInt(&b, s.polymers); putN(doc, "ap_", i, &b);
		text.put(&b, " "); text.putInt(&b, s.parts); text.put(&b, " kg"); putN(doc, "am_", i, &b);
		showN(doc, "abs_", i, s.steel > 0);
		showN(doc, "abe_", i, s.electronics > 0);
		showN(doc, "abp_", i, s.polymers > 0);
		showN(doc, "abm_", i, s.parts > 0);
		if not build.attachUnlocked(s) { text.put(&b, "locked"); }
		else if not build.canAffordAttach(s) { text.put(&b, "need materials"); }
		else if st.build_attach == i {
			if st.aim_host >= 0 and build.g_ghost_why.length > 0 { text.put(&b, build.g_ghost_why); }
			else { text.put(&b, "aim, R turns, LMB fits"); }
		}
		else { text.put(&b, " "); }
		putN(doc, "ast_", i, &b);
	}
}

// the selected module's racks, one row each with its HP and a remove button; a last row for the free slots
fn rackRows(doc : Document, sel : i32) : void {
	var b : text.Buf = undefined;
	text.clear(&b);
	const slots = sel >= 0 ? defs.rackSlots(st.modules[sel].kind) : 0;
	var n : i32 = 0;
	for k in 0..10 {
		const i = sel >= 0 ? build.rackOf(sel, k) : -1;
		showN(doc, "rk_", k + 1, i >= 0);
		if i < 0 { continue; }
		n += 1;
		const r = st.racks[i];
		const s = cfg.rackStats(cfg.rackKind(r.kind));
		text.put(&b, s.name);
		if r.task > 0 { text.put(&b, " "); putTask(&b, r.task, r.task_left, r.task_total); if r.worker < 0 { text.put(&b, " PAUSED"); } }
		putN(doc, "rk_t_", k + 1, &b);
		const bench = (s.sorts or s.research > 0.0 or s.exercise) and r.task != st.TASK_BUILD;
		showN(doc, "rkj_", k + 1, bench and s.sorts);
		if bench and s.sorts { text.put(&b, cfg.workshopJobName(r.job)); putN(doc, "rkj_t_", k + 1, &b); }
		showN(doc, "rks_", k + 1, bench);
		if bench {
			if r.staff >= 0 { text.put(&b, st.crewName(r.staff)); } else { text.put(&b, s.exercise ? "use" : "staff"); }
			putN(doc, "rks_t_", k + 1, &b);
		}
	}
	show(doc, "rk_free", slots > 0);
	if slots > 0 { text.put(&b, "Racks: "); text.putInt(&b, n); text.put(&b, " of "); text.putInt(&b, slots); text.put(&b, " slots (RACKS tab fits more)"); put(doc, "rk_free_t", &b); }
}

fn modulePanel(doc : Document) : void {
	const att = st.selected_attach >= 0 and st.selected_attach < st.attach_count;
	show(doc, "mi_dis", att);
	show(doc, "mi_ship", false);
	show(doc, "mi_boost", false);
	if att or st.selected_module < 0 { rackRows(doc, -1); }
	if att { show(doc, "modinfo", true); attachPanel(doc); return; }
	const sel = st.selected_module;
	show(doc, "modinfo", sel >= 0 and sel < st.module_count);
	if sel < 0 or sel >= st.module_count { return; }
	var b : text.Buf = undefined;
	text.clear(&b);
	const m = st.modules[sel];
	const d = defs.getDef(m.kind);
	const hp = m.hp;
	text.put(&b, d.name);
	if defs.rackSlots(m.kind) > 0 and m.kind != .Central { text.put(&b, " - "); text.put(&b, themeName(m.theme)); }
	put(doc, "mi_title", &b);
	const offline = hp <= 0.0;
	if offline { text.put(&b, "OFFLINE - 0% HP, repair to restart"); }
	else { text.put(&b, "Condition "); text.putInt(&b, (hp * 100.0 + 0.5) as i32); text.put(&b, "%, output x"); text.putF1(&b, hp); }
	put(doc, hp < cfg.HP_WARN ? "mi_hp_bad" : "mi_hp", &b);
	show(doc, "mi_hp", hp >= cfg.HP_WARN);
	show(doc, "mi_hp_bad", hp < cfg.HP_WARN);
	bar(doc, "mi_bar", hp);

	g_mi_line = 0;
	for k in 1..13 { showN(doc, "mi_r", k, false); }
	miProd(doc, "Power", d.power, hp, " kW", &b);
	if d.power < 0.0 { text.put(&b, "Power draw: "); text.putF1(&b, offline ? 0.0 : -d.power); text.put(&b, " kW"); miLine(doc, &b); }
	miProd(doc, "Oxygen", d.o2 * cfg.MINUTES_PER_DAY, hp, " L/day", &b);
	miProd(doc, "Food", d.food, hp, " kcal/day", &b);
	miProd(doc, "Research", d.research, hp, " RP/h", &b);
	miProd(doc, "Cooling", d.cooling, hp, " kW", &b);
	miProd(doc, "CO2 removal", d.co2_scrub * cfg.MINUTES_PER_DAY, hp, " L/day", &b);
	if d.crew > 0 { text.put(&b, "Berths: "); text.putInt(&b, d.crew); miLine(doc, &b); }
	if d.o2_store > 0.0 { text.put(&b, "Oxygen tanks: "); text.putGrouped(&b, d.o2_store as i32); text.put(&b, " L"); miLine(doc, &b); }
	if d.food_store > 0.0 { text.put(&b, "Food storage: "); text.putGrouped(&b, d.food_store as i32); text.put(&b, " kcal"); miLine(doc, &b); }
	if d.fuel_store > 0.0 { text.put(&b, "Fuel tanks: "); text.putGrouped(&b, d.fuel_store as i32); text.put(&b, " kg"); miLine(doc, &b); }
	if d.mixed_store > 0.0 { text.put(&b, "Cargo hold: "); text.putGrouped(&b, d.mixed_store as i32); text.put(&b, " kg"); miLine(doc, &b); }
	if d.battery > 0.0 { text.put(&b, "Battery: "); text.putF1(&b, d.battery); text.put(&b, " kWh"); miLine(doc, &b); }
	text.put(&b, "Mass "); text.putF1(&b, d.mass); text.put(&b, " t, volume "); text.putInt(&b, d.volume as i32); text.put(&b, " m3"); miLine(doc, &b);
	rackRows(doc, sel);
	taskLine(doc, m.task, m.task_left, m.task_total, m.worker);
	if st.repair_all_left > 0.0 and m.task == 0 { taskLine(doc, 3, st.repair_all_left, st.repair_all_total, st.repair_all_worker); }
	const slots = defs.slotCount(m.kind);
	if slots > 0 {
		var used : i32 = 0;
		for i in 0..st.attach_count { if st.attachments[i].host == sel { used += 1; } }
		text.put(&b, "Hull slots: "); text.putInt(&b, used); text.put(&b, " of "); text.putInt(&b, slots); text.put(&b, " used (repair covers them)"); miLine(doc, &b);
	}
	// docking hub: its shuttle, or a button to build one
	const hub = m.kind == .DockingHub and m.task != st.TASK_BUILD;
	show(doc, "mi_ship", hub and m.ship == st.SHIP_NONE and m.task == st.TASK_NONE);
	show(doc, "mi_boost", m.kind == .Central and m.task != st.TASK_BUILD);
	if m.kind == .Central {
		if st.boosting { text.put(&b, "Stop reboost burn (B)"); }
		else { text.put(&b, "Reboost to "); text.putInt(&b, cfg.BOOST_TARGET_KM as i32); text.put(&b, " km: "); text.putInt(&b, reboostCost() as i32); text.put(&b, " kg (B)"); }
		put(doc, "mi_boost_t", &b);
	}
	if hub {
		if m.ship == st.SHIP_DOCKED { text.put(&b, "Shuttle docked, ready to fly"); }
		else if m.ship == st.SHIP_AWAY { text.put(&b, "Shuttle away on a mission"); }
		else if m.task == st.TASK_SHIP { text.put(&b, "Shuttle under construction"); }
		else { text.put(&b, "No shuttle - build one to fly missions"); }
		miLine(doc, &b);
		text.put(&b, "Build shuttle: "); text.putInt(&b, cfg.SHIP_STEEL); text.put(&b, " steel, "); text.putInt(&b, cfg.SHIP_ELECTRONICS); text.put(&b, " elec, ");
		text.putInt(&b, cfg.SHIP_POLYMERS); text.put(&b, " poly, "); text.putInt(&b, cfg.SHIP_PARTS); text.put(&b, " parts");
		put(doc, "mi_ship_t", &b);
	}

	var steel : f32 = 0.0;
	var poly : f32 = 0.0;
	sim.repairCostOf(sel, &steel, &poly);
	if steel < 0.5 and poly < 0.5 { text.put(&b, "In full repair"); }
	else if st.res.kits >= sim.kitsFor(steel) { text.put(&b, "Repair: "); text.putInt(&b, sim.kitsFor(steel) as i32); text.put(&b, " kit(s), 30 min"); }
	else { text.put(&b, "Repair: "); text.putInt(&b, (steel + 0.5) as i32); text.put(&b, " kg steel, "); text.putInt(&b, (poly + 0.5) as i32); text.put(&b, " kg polymers"); }
	put(doc, "mi_repair", &b);
}

// ---- crew status text ---------------------------------------------------------------------------------------------------------------------------------
// one button per living crew member (up to 12): name and what they do; the selected one does the next action


// "building 40%" etc. for a task of `total` minutes with `left` remaining
fn putTask(b : *text.Buf, task : i32, left : f32, total : f32) : void {
	match task {
		case 1: text.put(b, "building");
		case 2: text.put(b, "dismantling");
		case 4: text.put(b, "shuttle");
		case: text.put(b, "repairing");
	}
	text.put(b, " ");
	const done = total > 0.0 ? 1.0 - left / total : 0.0;
	text.putInt(b, (done * 100.0) as i32); text.put(b, "%");
}

fn putCrewStatus(b : *text.Buf, c : i32) : void {
	const job = st.crew_list[c].job;
	if job == st.JOB_IDLE { text.put(b, st.crew_list[c].injury == st.INJURY_MINOR ? "idle, hurt" : "idle"); return; }
	if job == st.JOB_HURT { text.put(b, "badly hurt"); return; }
	if job == st.JOB_CARE { text.put(b, "nursing"); return; }
	if job == st.JOB_EXERCISE { text.put(b, "exercise "); text.putInt(b, (st.crew_list[c].fitness * 100.0) as i32); text.put(b, "%"); return; }
	if job == st.JOB_BENCH {
		for i in 0..st.rack_count {
			if st.racks[i].staff != c { continue; }
			const r = st.racks[i];
			if not cfg.rackStats(cfg.rackKind(r.kind)).sorts { text.put(b, "research"); return; }
			match r.job {
				case 1: text.put(b, "parts");
				case 2: text.put(b, "kits");
				case 3: text.put(b, "drills");
				case: text.put(b, "sorting"); return;
			}
			const total = r.job == 1 ? cfg.PARTS_MINUTES : (r.job == 3 ? cfg.DRILL_MINUTES : cfg.KIT_MINUTES);
			if r.batch > 0.0 { text.put(b, " "); text.putInt(b, ((1.0 - r.batch / total) * 100.0) as i32); text.put(b, "%"); }
			else { text.put(b, " - no input"); }
			return;
		}
		text.put(b, "bench");
		return;
	}
	if job == st.JOB_MISSION {
		for i in 0..st.mission_count {
			if st.missions[i].worker == c { text.put(b, st.missions[i].hub >= 0 ? "flying " : "EVA "); putTime(b, st.missions[i].left); return; }
		}
		text.put(b, "flying");
		return;
	}
	if job == st.JOB_BOOST { text.put(b, "reboost"); return; }
	if job == st.JOB_REPAIR_ALL { putTask(b, 3, st.repair_all_left, st.repair_all_total); return; }
	for i in 0..st.module_count { const m = st.modules[i]; if m.worker == c and m.task > 0 { putTask(b, m.task, m.task_left, m.task_total); return; } }
	for i in 0..st.rack_count { const r = st.racks[i]; if r.worker == c and r.task > 0 { putTask(b, r.task, r.task_left, r.task_total); return; } }
	for i in 0..st.attach_count { const a = st.attachments[i]; if a.worker == c and a.task > 0 { putTask(b, a.task, a.task_left, a.task_total); return; } }
	text.put(b, "working");
}

// ---- active tasks panel ----------------------------------------------------------------------------------------------------------------------
// one row per task under way (up to 8): building / fitting / dismantling / repairing and missions, with the worker, time left and a progress bar

fn taskRow(doc : Document, n : *i32, b : *text.Buf, fraction : f32) : void {
	if n.* >= 8 { text.clear(b); return; }
	n.* += 1;
	text.put(b, "  ("); text.putInt(b, (fraction * 100.0) as i32); text.put(b, "%)");
	var id : text.Buf = undefined;
	text.clear(&id); text.put(&id, "tk_b_"); text.putInt(&id, n.*);
	bar(doc, text.view(&id), fraction);
	putN(doc, "tk_t_", n.*, b);
	showN(doc, "tk_", n.*, true);
}

// "Ada: Building Small Hull, 12 min left" or "... - PAUSED" when nobody works on it
fn taskText(b : *text.Buf, task : i32, fitting : bool, name : []const u8, left : f32, worker : i32) : void {
	if worker >= 0 { text.put(b, st.crewName(worker)); text.put(b, ": "); }
	putTaskVerb(b, task, fitting); text.put(b, name);
	if worker >= 0 { text.put(b, ", "); putTime(b, left / st.workSpeed(worker, task)); text.put(b, " left"); }
	else { text.put(b, " - PAUSED"); }
}

fn tasksPanel(doc : Document) : void {
	var b : text.Buf = undefined;
	text.clear(&b);
	var n : i32 = 0;
	for i in 0..st.module_count {
		const m = st.modules[i];
		if m.task == st.TASK_NONE { continue; }
		taskText(&b, m.task, false, defs.getDef(m.kind).name, m.task_left, m.worker);
		taskRow(doc, &n, &b, m.task_total > 0.0 ? 1.0 - m.task_left / m.task_total : 0.0);
	}
	for i in 0..st.rack_count {
		const r = st.racks[i];
		if r.task == st.TASK_NONE { continue; }
		taskText(&b, r.task, true, cfg.rackStats(cfg.rackKind(r.kind)).name, r.task_left, r.worker);
		taskRow(doc, &n, &b, r.task_total > 0.0 ? 1.0 - r.task_left / r.task_total : 0.0);
	}
	for i in 0..st.attach_count {
		const a = st.attachments[i];
		if a.task == st.TASK_NONE { continue; }
		taskText(&b, a.task, true, cfg.attachStats(cfg.attachKind(a.kind)).name, a.task_left, a.worker);
		taskRow(doc, &n, &b, a.task_total > 0.0 ? 1.0 - a.task_left / a.task_total : 0.0);
	}
	if st.repair_all_left > 0.0 {
		const w = st.repair_all_worker;
		if w >= 0 { text.put(&b, st.crewName(w)); text.put(&b, ": "); }
		text.put(&b, "Repairing the whole station");
		if w >= 0 { text.put(&b, ", "); putTime(&b, st.repair_all_left / st.workSpeed(w, 3)); text.put(&b, " left"); } else { text.put(&b, " - PAUSED"); }
		taskRow(doc, &n, &b, st.repair_all_total > 0.0 ? 1.0 - st.repair_all_left / st.repair_all_total : 0.0);
	}
	for i in 0..st.mission_count {
		const ms = st.missions[i];
		if ms.worker >= 0 { text.put(&b, st.crewName(ms.worker)); text.put(&b, ": "); }
		text.put(&b, cfg.missionStats(cfg.missionKind(ms.c.kind)).name); text.put(&b, ms.hub >= 0 ? ", flying, back in " : ", EVA, back in "); putTime(&b, ms.left);
		taskRow(doc, &n, &b, ms.total > 0.0 ? 1.0 - ms.left / ms.total : 0.0);
	}
	for j in (n + 1)..9 { showN(doc, "tk_", j, false); }
	show(doc, "tasks", n > 0 and not st.menu and not g_pick);
}

// highlights crew member c (a crew_list index) in the roster; it has no effect on orders, those ask per task
fn selectCrewIndex(c : i32) : void {
	if c < 0 or c >= st.crew_slots or not st.crew_list[c].alive { return; }
	st.selected_crew = st.selected_crew == c ? -1 : c;
	g_timer = 0.0;
}

// ---- crew choice popup ------------------------------------------------------------------------------------------------------------------------
// an order that needs a crew member (st.takeCrew found none chosen) opens a popup of the free ones; the pick replays the order with them

var g_pick : bool = false;                      // the popup is open
var g_pick_act : text.Buf = undefined;          // the action to replay
var g_pick_map : [12]i32 = undefined;           // popup button k (0-based) -> crew index
var g_pend_rack_host : i32 = -1;                // module under the cursor of a pending rack placement
var g_pend_mod : i32 = -1;                      // module / attachment of a pending "resume work" click
var g_pend_att : i32 = -1;
var g_pend_aim_socket : i32 = -1;               // what the mouse ray aimed at when the placement was clicked
var g_pend_aim_host : i32 = -1;
var g_pend_aim_slot : i32 = -1;

fn askCrew(action : []const u8) : void {
	text.clear(&g_pick_act);
	text.put(&g_pick_act, action);
	g_pend_aim_socket = st.aim_socket;
	g_pend_aim_host = st.aim_host;
	g_pend_aim_slot = st.aim_slot;
	g_result = "";   // the order's own "need a crew member" reason is not an error
	g_pick = true;
}

// crew members that can take a new job: idle ones, and bench / exercise workers (they leave their machine)
fn pickable(c : i32) : bool {
	if not st.crew_list[c].alive { return false; }
	const job = st.crew_list[c].job;
	return job == st.JOB_IDLE or job == st.JOB_BENCH or job == st.JOB_EXERCISE;
}

fn pickPopup(doc : Document) : void {
	show(doc, "crewpick", g_pick and not st.menu);
	if not g_pick { return; }
	var b : text.Buf = undefined;
	text.clear(&b);
	var k : i32 = 0;
	for c in 0..st.crew_slots {
		if not pickable(c) or k >= 12 { continue; }
		g_pick_map[k] = c;
		k += 1;
		text.put(&b, st.crewName(c));
		putN(doc, "pk_n_", k, &b);
		text.put(&b, "    "); putCrewStatus(&b, c);
		putN(doc, "pk_t_", k, &b);
		const cm = st.crew_list[c];
		text.put(&b, "STR "); text.putInt(&b, cm.stats[cfg.STAT_STR]);
		text.put(&b, "   INT "); text.putInt(&b, cm.stats[cfg.STAT_INT]);
		text.put(&b, "   DEX "); text.putInt(&b, cm.stats[cfg.STAT_DEX]);
		text.put(&b, "   END "); text.putInt(&b, cm.stats[cfg.STAT_END]);
		text.put(&b, "   FIT "); text.putInt(&b, (cm.fitness * 100.0) as i32); text.put(&b, "%");
		putN(doc, "pk_s_", k, &b);
		showN(doc, "pk_", k, true);
	}
	for j in (k + 1)..13 { showN(doc, "pk_", j, false); }
	for j in k..12 { g_pick_map[j] = -1; }
	show(doc, "pk_none", k == 0);
}

// replays the pending action with crew member c
fn runPending(world : World, c : i32) : void {
	g_pick = false;
	st.aim_socket = g_pend_aim_socket;
	st.aim_host = g_pend_aim_host;
	st.aim_slot = g_pend_aim_slot;
	st.assignee = c;
	st.crew_wanted = false;
	dispatch(world, text.view(&g_pick_act));
	st.assignee = -1;
	st.crew_wanted = false;
}

fn pickCrew(world : World, k : i32) : void {
	if k < 0 or k >= 12 { return; }
	const c = g_pick_map[k];
	if c < 0 or c >= st.crew_slots or not pickable(c) { return; }
	runPending(world, c);
}

fn placeNow(world : World) : void {
	const why = build.placeAimed(world, g_pend_rack_host);
	if why.length > 0 { g_result = why; g_result_t = 2.5; }
}

fn resumeNow() : void {
	const resumed = build.resumeWork(g_pend_mod, g_pend_att);
}

// ---- crew roster (CREW panel) -----------------------------------------------------------------------------------------------------------------
// one row per crew slot (ids crr_ / crn* / crs* / crd_ <1..24>): name, aboard / away, and in full what they are doing, where, how far along

// left is work at average speed: at the worker's speed it takes left / speed
fn putProgress(b : *text.Buf, left : f32, total : f32, speed : f32) : void {
	const done = total > 0.0 ? 1.0 - left / total : 0.0;
	text.put(b, " - "); text.putInt(b, (done * 100.0) as i32); text.put(b, "%, "); putTime(b, left / speed); text.put(b, " left");
}

fn putTaskVerb(b : *text.Buf, task : i32, fitting : bool) : void {
	match task {
		case 1: text.put(b, fitting ? "Fitting " : "Building ");
		case 2: text.put(b, fitting ? "Removing " : "Dismantling ");
		case 4: text.put(b, "Building a shuttle at the ");
		case: text.put(b, "Repairing ");
	}
}

fn putCrewDetail(b : *text.Buf, c : i32) : void {
	const job = st.crew_list[c].job;
	if job == st.JOB_IDLE { text.put(b, st.crew_list[c].injury == st.INJURY_MINOR ? "Idle, hurt: works slower until healed" : "Idle - ready for orders"); return; }
	if job == st.JOB_HURT {
		text.put(b, "Badly hurt: ");
		if st.crew_list[c].injury_left < cfg.INJURY_SERIOUS_CARE_MINUTES - 0.5 { text.put(b, "being nursed, "); putTime(b, st.crew_list[c].injury_left); text.put(b, " left"); }
		else { text.put(b, "needs a medical bay and a caregiver, "); putTime(b, st.crew_list[c].doom); text.put(b, " to live"); }
		return;
	}
	if job == st.JOB_CARE { text.put(b, "Nursing "); const p = st.crew_list[c].care; if p >= 0 and p < st.crew_slots { text.put(b, st.crewName(p)); } return; }
	if job == st.JOB_MISSION {
		for i in 0..st.mission_count {
			const m = st.missions[i];
			if m.worker != c { continue; }
			text.put(b, m.hub >= 0 ? "Piloting the shuttle: " : "On EVA: "); text.put(b, cfg.missionStats(cfg.missionKind(m.c.kind)).name); text.put(b, ", back in "); putTime(b, m.left);
			return;
		}
		text.put(b, "Piloting the shuttle");
		return;
	}
	if job == st.JOB_BOOST { text.put(b, "At the controls: reboost burn to "); text.putInt(b, cfg.BOOST_TARGET_KM as i32); text.put(b, " km"); return; }
	if job == st.JOB_REPAIR_ALL { text.put(b, "Repairing the station"); putProgress(b, st.repair_all_left, st.repair_all_total, st.workSpeed(c, st.TASK_REPAIR)); return; }
	if job == st.JOB_EXERCISE {
		const m = sim.exerciseRack(c);
		if m < 0 { text.put(b, "Waiting at a broken exercise machine"); return; }
		text.put(b, "Exercising ("); text.put(b, defs.getDef(st.modules[st.racks[m].host].kind).name); text.put(b, "), fit in ");
		putTime(b, (1.0 - st.crew_list[c].fitness) / (cfg.FITNESS_GAIN_PER_HOUR * st.racks[m].hp) * 60.0);
		return;
	}
	if job == st.JOB_BENCH {
		for i in 0..st.rack_count {
			const r = st.racks[i];
			if r.staff != c { continue; }
			const s = cfg.rackStats(cfg.rackKind(r.kind));
			text.put(b, s.name); text.put(b, " ("); text.put(b, defs.getDef(st.modules[r.host].kind).name); text.put(b, "): ");
			if not s.sorts { text.putF1(b, s.research * r.hp * st.statOf(c, cfg.STAT_INT) * st.tot.efficiency); text.put(b, " RP/h"); return; }
			match r.job {
				case 1: text.put(b, "machine parts");
				case 2: text.put(b, "repair kits");
				case 3: text.put(b, "mining drills");
				case:
					text.put(b, st.res.mixed > 0.01 ? "sorting salvage" : "sorting - hold empty");
					return;
			}
			const total = r.job == 1 ? cfg.PARTS_MINUTES : (r.job == 3 ? cfg.DRILL_MINUTES : cfg.KIT_MINUTES);
			if r.batch > 0.0 { text.put(b, " "); text.putInt(b, ((1.0 - r.batch / total) * 100.0) as i32); text.put(b, "%"); }
			else { text.put(b, " - no input"); }
			return;
		}
		text.put(b, "At a bench");
		return;
	}
	for i in 0..st.module_count {
		const m = st.modules[i];
		if m.worker != c or m.task == st.TASK_NONE { continue; }
		putTaskVerb(b, m.task, false); text.put(b, defs.getDef(m.kind).name); putProgress(b, m.task_left, m.task_total, st.workSpeed(c, m.task));
		return;
	}
	for i in 0..st.rack_count {
		const r = st.racks[i];
		if r.worker != c or r.task == st.TASK_NONE { continue; }
		putTaskVerb(b, r.task, true); text.put(b, cfg.rackStats(cfg.rackKind(r.kind)).name); putProgress(b, r.task_left, r.task_total, st.workSpeed(c, r.task));
		return;
	}
	for i in 0..st.attach_count {
		const a = st.attachments[i];
		if a.worker != c or a.task == st.TASK_NONE { continue; }
		putTaskVerb(b, a.task, true); text.put(b, cfg.attachStats(cfg.attachKind(a.kind)).name); putProgress(b, a.task_left, a.task_total, st.workSpeed(c, a.task));
		return;
	}
	text.put(b, "Working");
}

// shows exactly one of the spans <a|b|c>_<n>, filling it from the buffer
fn oneOf(doc : Document, a : []const u8, b2 : []const u8, c2 : []const u8, n : i32, pick : i32, b : *text.Buf) : void {
	putN(doc, pick == 0 ? a : (pick == 1 ? b2 : c2), n, b);
	showN(doc, a, n, pick == 0);
	showN(doc, b2, n, pick == 1);
	showN(doc, c2, n, pick == 2);
}

fn crewRoster(doc : Document) : void {
	var b : text.Buf = undefined;
	text.clear(&b);
	var away : i32 = 0;
	var idle : i32 = 0;
	for c in 0..st.crew_slots {
		if not st.crew_list[c].alive { continue; }
		const job = st.crew_list[c].job;
		if job == st.JOB_MISSION { away += 1; }
		if job == st.JOB_IDLE { idle += 1; }
	}
	text.putInt(&b, st.crew); text.put(&b, " crew: "); text.putInt(&b, st.crew - away); text.put(&b, " aboard, "); text.putInt(&b, away); text.put(&b, " away, ");
	text.putInt(&b, idle); text.put(&b, " idle"); putN(doc, "cr_", 1, &b);
	text.put(&b, "Berths "); text.putInt(&b, st.crew); text.put(&b, " of "); text.putInt(&b, st.tot.crew_cap); text.put(&b, " used, ");
	if st.crew > st.tot.crew_cap { text.put(&b, "OVER CAPACITY by "); text.putInt(&b, st.crew - st.tot.crew_cap); }
	else { text.putInt(&b, sim.rescueSpace() > 0 ? sim.rescueSpace() : 0); text.put(&b, " free for newcomers"); }
	putN(doc, "cr_", 2, &b);
	text.put(&b, "STR build, sort, haul / INT research, workshop, repair / DEX build, repair, safety / END time away"); putN(doc, "cr_", 3, &b);
	for k in 0..cfg.CREW_MAX {
		const n = k + 1;
		const on = k < st.crew_slots;
		showN(doc, "crr_", n, on);
		if not on { continue; }
		const cm = st.crew_list[k];
		const job = cm.job;
		text.put(&b, st.crewName(k));
		oneOf(doc, "crn_", "crns_", "crnd_", n, not cm.alive ? 2 : (k == st.selected_crew ? 1 : 0), &b);
		if not cm.alive { text.put(&b, "deceased"); }
		else if job == st.JOB_MISSION { text.put(&b, "away"); }
		else if job == st.JOB_IDLE { text.put(&b, "idle"); }
		else { text.put(&b, "aboard"); }
		oneOf(doc, "crs_", "crsa_", "crsd_", n, not cm.alive ? 2 : (job == st.JOB_MISSION ? 1 : 0), &b);
		// stats: 7 and up stand out
		for i in 0..cfg.STAT_COUNT {
			const v = cm.stats[i];
			var id : text.Buf = undefined;
			text.clear(&id); text.put(&id, "crv"); text.putInt(&id, i); text.put(&id, "_");
			var idh : text.Buf = undefined;
			text.clear(&idh); text.put(&idh, "crvh"); text.putInt(&idh, i); text.put(&idh, "_");
			text.putInt(&b, v);
			putN(doc, v >= 7 ? text.view(&idh) : text.view(&id), n, &b);
			showN(doc, text.view(&id), n, v < 7);
			showN(doc, text.view(&idh), n, v >= 7);
		}
		// fitness: red when it already costs them performance
		const low = cm.alive and cm.fitness < cfg.FITNESS_LOW;
		if cm.alive { text.putInt(&b, (cm.fitness * 100.0 + 0.5) as i32); text.put(&b, "%"); } else { text.put(&b, "-"); }
		putN(doc, low ? "crfl_" : "crf_", n, &b);
		showN(doc, "crf_", n, not low);
		showN(doc, "crfl_", n, low);
		if cm.alive { putCrewDetail(&b, k); } else { text.put(&b, " "); }
		putN(doc, "crd_", n, &b);
	}
}

// "crsel_<n>" -> n - 1, -1 for any other action
fn rosterIndex(action : []const u8) : i32 {
	if action.length < 7 or action[0:6] != "crsel_" { return -1; }
	var n : i32 = 0;
	for i in 6..(action.length as i32) {
		const ch = action[i];
		if ch < '0' or ch > '9' { return -1; }
		n = n * 10 + (ch - '0') as i32;
	}
	return n - 1;
}

// task line for an item in the module panel
fn taskLine(doc : Document, task : i32, left : f32, total : f32, worker : i32) : void {
	show(doc, "mi_task", task > 0);
	if task <= 0 { return; }
	var b : text.Buf = undefined;
	text.clear(&b);
	putTask(&b, task, left, total);
	if worker >= 0 { text.put(&b, " - "); text.put(&b, st.crewName(worker)); text.put(&b, ", "); putTime(&b, left / st.workSpeed(worker, task)); text.put(&b, " left"); }
	else { text.put(&b, " - PAUSED: click this module to assign someone"); }
	put(doc, "mi_task_t", &b);
}

fn resourcesPanel(doc : Document) : void {
	var b : text.Buf = undefined;
	text.clear(&b);
	const t = st.tot;
	const crew = st.crew as f32;

	// mixed salvage: missions bring it in, the sorting line turns it into the materials below
	const sort_rate = t.sorting ? t.sort_rate * (1.0 + t.sort_bonus) * t.efficiency : 0.0;
	text.putGrouped(&b, st.res.mixed as i32); text.put(&b, " / "); text.putGrouped(&b, t.mixed_cap as i32); text.put(&b, " kg"); putN(doc, "rs_s_", 15, &b);
	barN(doc, 15, ratio(st.res.mixed, t.mixed_cap));
	cell(doc, "rs_i_", 15, "missions", &b);
	putOut(&b, sort_rate); text.put(&b, " kg/h"); putN(doc, "rs_o_", 15, &b);
	putOut(&b, sort_rate); text.put(&b, " kg/h"); putN(doc, "rs_np_", 15, &b); showN(doc, "rs_np_", 15, true); showN(doc, "rs_nm_", 15, false);
	if t.sorting { text.put(&b, "sorting, done in "); putTime(&b, sort_rate > 0.001 ? st.res.mixed / sort_rate * 60.0 : 0.0); }
	else if st.res.mixed > 0.01 { text.put(&b, "waiting - staff a workshop bench to sort it"); }
	else { text.put(&b, "hold empty - scavenge scrap or fly a debris field mission"); }
	statusCell(doc, 15, false, &b);

	// materials: sorting brings them in, building spends them
	for r in 1..5 {
		var v : f32 = st.res.steel;
		var share : f32 = cfg.SORT_STEEL;
		match r {
			case 2: v = st.res.electronics; share = cfg.SORT_ELECTRONICS;
			case 3: v = st.res.polymers; share = cfg.SORT_POLYMERS;
			case 4: v = st.res.parts; share = cfg.SORT_PARTS;
			case:
		}
		text.putGrouped(&b, v as i32); text.put(&b, " kg"); putN(doc, "rs_s_", r, &b);
		if t.sorting { putSigned(&b, sort_rate * share); text.put(&b, " kg/h"); } else { text.put(&b, "sorting"); }
		putN(doc, "rs_i_", r, &b);
		cell(doc, "rs_o_", r, "building", &b);
		if t.sorting { netCell(doc, r, sort_rate * share, " kg/h", &b); }
		else { cell(doc, "rs_np_", r, "-", &b); showN(doc, "rs_np_", r, true); showN(doc, "rs_nm_", r, false); }
		text.putInt(&b, (share * 100.0 + 0.5) as i32); text.put(&b, "% of sorted salvage");
		statusCell(doc, r, false, &b);
	}

	// oxygen, per minute
	const o2_in = t.o2_prod * t.efficiency;
	const o2_out = crew * cfg.O2_PER_CREW;
	text.putGrouped(&b, st.res.o2 as i32); text.put(&b, " / "); text.putGrouped(&b, t.o2_cap as i32); text.put(&b, " L"); putN(doc, "rs_s_", 5, &b);
	barN(doc, 5, ratio(st.res.o2, t.o2_cap));
	putLday(&b, o2_in, true); putN(doc, "rs_i_", 5, &b);
	text.put(&b, "-"); putLday(&b, o2_out, false); putN(doc, "rs_o_", 5, &b);
	lNetCell(doc, 5, o2_in - o2_out, false, &b);
	stockStatus(doc, 5, st.res.o2, t.o2_cap, o2_in - o2_out, 6.0 * 60.0, &b);

	// water, per day: the crew use it, a recycler gives most of it back
	const water_use = crew * cfg.WATER_PER_CREW;
	const water_back = water_use * t.water_recovery;
	text.putGrouped(&b, st.res.water as i32); text.put(&b, " / "); text.putInt(&b, cfg.WATER_CAP as i32); text.put(&b, " L"); putN(doc, "rs_s_", 16, &b);
	barN(doc, 16, ratio(st.res.water, cfg.WATER_CAP));
	putSigned(&b, water_back); text.put(&b, " L/day"); putN(doc, "rs_i_", 16, &b);
	putOut(&b, water_use); text.put(&b, " L/day"); putN(doc, "rs_o_", 16, &b);
	netCell(doc, 16, water_back - water_use, " L/day", &b);
	stockStatus(doc, 16, st.res.water, cfg.WATER_CAP, (water_back - water_use) / cfg.MINUTES_PER_DAY, 3.0 * cfg.MINUTES_PER_DAY, &b);

	// carbon dioxide, L per minute; stock as ppm, the bar fills towards the lethal level
	const co2_in = crew * cfg.CO2_PER_CREW;
	const co2_out = t.co2_scrub * (t.co2_efficiency > 0.0 ? t.efficiency / t.co2_efficiency : 0.0);   // scrubbers run at the machine efficiency
	text.putGrouped(&b, t.co2_ppm as i32); text.put(&b, " ppm"); putN(doc, "rs_s_", 12, &b);
	barN(doc, 12, t.co2_ppm / cfg.CO2_LETHAL_PPM);
	putLday(&b, co2_in, true); putN(doc, "rs_i_", 12, &b);
	text.put(&b, "-"); putLday(&b, co2_out, false); putN(doc, "rs_o_", 12, &b);
	// for CO2 a rise is the bad direction: show the net in red when it grows
	const co2_net = co2_in - co2_out;
	lNetCell(doc, 12, co2_net, true, &b);
	const ppm_per_min = t.volume > 0.0 ? co2_net / (t.volume * 1000.0) * 1000000.0 : 0.0;
	if t.co2_ppm >= cfg.CO2_LETHAL_PPM { text.put(&b, "LETHAL - crew are dying"); statusCell(doc, 12, true, &b); }
	else if t.co2_ppm >= cfg.CO2_WARN_PPM {
		text.put(&b, "HEADACHES, output x"); text.putF1(&b, t.co2_efficiency);
		if ppm_per_min > 0.001 { text.put(&b, ", lethal in "); putTime(&b, (cfg.CO2_LETHAL_PPM - t.co2_ppm) / ppm_per_min); }
		statusCell(doc, 12, true, &b);
	}
	else if ppm_per_min > 0.001 { text.put(&b, "rising, headaches in "); putTime(&b, (cfg.CO2_WARN_PPM - t.co2_ppm) / ppm_per_min); statusCell(doc, 12, false, &b); }
	else { text.put(&b, "scrubbers keep up ("); putLday(&b, co2_out - co2_in, false); text.put(&b, " spare)"); statusCell(doc, 12, false, &b); }

	// food, per day
	const food_in = t.food_prod * t.efficiency;
	const food_out = crew * cfg.FOOD_PER_CREW;
	text.putGrouped(&b, st.res.food as i32); text.put(&b, " / "); text.putGrouped(&b, t.food_cap as i32); text.put(&b, " kcal"); putN(doc, "rs_s_", 6, &b);
	barN(doc, 6, ratio(st.res.food, t.food_cap));
	putKcal(&b, food_in, true); putN(doc, "rs_i_", 6, &b);
	putKcal(&b, -food_out, false); putN(doc, "rs_o_", 6, &b);
	kcalNetCell(doc, 6, food_in - food_out, &b);
	stockStatus(doc, 6, st.res.food, t.food_cap, (food_in - food_out) / cfg.MINUTES_PER_DAY, cfg.MINUTES_PER_DAY, &b);

	// power, kW
	const surplus = t.power_prod - t.power_cons;
	cell(doc, "rs_s_", 7, "-", &b);
	putSigned(&b, t.power_prod); text.put(&b, " kW"); putN(doc, "rs_i_", 7, &b);
	putOut(&b, t.power_cons); text.put(&b, " kW"); putN(doc, "rs_o_", 7, &b);
	netCell(doc, 7, surplus, " kW", &b);
	if t.power_ratio < 0.999 { text.put(&b, "BROWNOUT, modules at "); text.putInt(&b, (t.power_ratio * 100.0) as i32); text.put(&b, "%"); statusCell(doc, 7, true, &b); }
	else if surplus < -0.05 { text.put(&b, "deficit covered by the battery"); statusCell(doc, 7, true, &b); }
	else if surplus > 0.05 and t.batt_cap > 0.0 { text.put(&b, "surplus charges the battery"); statusCell(doc, 7, false, &b); }
	else if surplus > 0.05 { text.put(&b, "surplus wasted, no battery bank"); statusCell(doc, 7, false, &b); }
	else { text.put(&b, "balanced"); statusCell(doc, 7, false, &b); }

	// battery, kWh (charged by the surplus, drained by the deficit: kW = kWh per hour)
	text.putF1(&b, st.res.battery); text.put(&b, " / "); text.putF1(&b, t.batt_cap); text.put(&b, " kWh"); putN(doc, "rs_s_", 8, &b);
	barN(doc, 8, ratio(st.res.battery, t.batt_cap));
	putSigned(&b, surplus > 0.0 ? surplus : 0.0); text.put(&b, " kW"); putN(doc, "rs_i_", 8, &b);
	putOut(&b, surplus < 0.0 ? -surplus : 0.0); text.put(&b, " kW"); putN(doc, "rs_o_", 8, &b);
	netCell(doc, 8, t.batt_cap > 0.0 ? surplus : 0.0, " kW", &b);
	if t.batt_cap <= 0.0 { text.put(&b, "no battery bank (research: Battery Bank)"); statusCell(doc, 8, false, &b); }
	else { stockStatus(doc, 8, st.res.battery, t.batt_cap, surplus / 60.0, 2.0 * 60.0, &b); }

	// heat, kW: waste heat of the consumers against the radiators
	cell(doc, "rs_s_", 9, "-", &b);
	putSigned(&b, t.heat); text.put(&b, " kW"); putN(doc, "rs_i_", 9, &b);
	putOut(&b, t.cooling); text.put(&b, " kW"); putN(doc, "rs_o_", 9, &b);
	netCell(doc, 9, t.cooling - t.heat, " kW", &b);
	if t.overheating { text.put(&b, "OVERHEATING, output x"); text.putF1(&b, cfg.OVERHEAT_EFFICIENCY); text.put(&b, " - add radiators"); statusCell(doc, 9, true, &b); }
	else { text.put(&b, "cooling margin "); text.putF1(&b, t.cooling - t.heat); text.put(&b, " kW"); statusCell(doc, 9, false, &b); }

	// fuel, kg: the reboost burn uses it (per game hour while burning); status: how much climb it buys
	const burn = st.boosting ? cfg.BOOST_KM_PER_HOUR * t.boost_fuel_per_km : 0.0;
	text.putGrouped(&b, st.res.fuel as i32); text.put(&b, " / "); text.putGrouped(&b, t.fuel_cap as i32); text.put(&b, " kg"); putN(doc, "rs_s_", 13, &b);
	barN(doc, 13, ratio(st.res.fuel, t.fuel_cap));
	cell(doc, "rs_i_", 13, "missions", &b);
	putOut(&b, burn); text.put(&b, " kg/h"); putN(doc, "rs_o_", 13, &b);
	netCell(doc, 13, -burn, " kg/h", &b);
	const km_left = t.boost_fuel_per_km > 0.0 ? st.res.fuel / t.boost_fuel_per_km : 0.0;
	const short = reboostCost() > st.res.fuel;
	text.put(&b, "enough for "); text.putInt(&b, km_left as i32); text.put(&b, " km of reboost ("); text.putF1(&b, t.boost_fuel_per_km); text.put(&b, " kg/km)");
	statusCell(doc, 13, short and st.res.altitude < cfg.ALT_WARN_KM, &b);

	// altitude, km: drag per day against the climb of a running burn
	const climb = st.boosting ? cfg.BOOST_KM_PER_HOUR * 24.0 : 0.0;
	text.putF1(&b, st.res.altitude); text.put(&b, " km"); putN(doc, "rs_s_", 14, &b);
	barN(doc, 14, (st.res.altitude - cfg.ALT_REENTRY_KM) / (cfg.ALT_MAX_KM - cfg.ALT_REENTRY_KM));
	putSigned(&b, climb); text.put(&b, " km/day"); putN(doc, "rs_i_", 14, &b);
	putOut(&b, t.decay); text.put(&b, " km/day"); putN(doc, "rs_o_", 14, &b);
	netCell(doc, 14, climb - t.decay, " km/day", &b);
	if st.boosting { text.put(&b, "REBOOSTING to "); text.putInt(&b, cfg.BOOST_TARGET_KM as i32); text.put(&b, " km"); statusCell(doc, 14, false, &b); }
	else if st.res.altitude < cfg.ALT_WARN_KM { text.put(&b, "LOW ORBIT, re-entry in "); putTime(&b, minutesUntilAltitude(cfg.ALT_REENTRY_KM)); statusCell(doc, 14, true, &b); }
	else { text.put(&b, "reboost needed in "); putTime(&b, minutesUntilAltitude(cfg.ALT_WARN_KM)); statusCell(doc, 14, false, &b); }

	// research, RP per hour; status: what is being researched
	const rp_rate = t.research * t.efficiency;
	putResearchStock(&b); putN(doc, "rs_s_", 10, &b);
	putSigned(&b, rp_rate); text.put(&b, "/h"); putN(doc, "rs_i_", 10, &b);
	cell(doc, "rs_o_", 10, "-", &b);
	netCell(doc, 10, rp_rate, "/h", &b);
	if st.tech_active > 0 {
		const ts = cfg.techStats(st.tech_active);
		text.put(&b, ts.name);
		if rp_rate > 0.001 { text.put(&b, ", done in "); putTime(&b, ((ts.cost as f32) - st.tech_prog[st.tech_active]) / rp_rate * 60.0); }
		else { text.put(&b, ", needs a research bench"); }
		statusCell(doc, 10, false, &b);
	}
	else { text.put(&b, "pick a technology (RESEARCH)"); statusCell(doc, 10, false, &b); }

	// crew and berths
	text.putInt(&b, st.crew); text.put(&b, " / "); text.putInt(&b, t.crew_cap); putN(doc, "rs_s_", 11, &b);
	barN(doc, 11, ratio(crew, t.crew_cap as f32));
	cell(doc, "rs_i_", 11, "missions", &b);
	cell(doc, "rs_o_", 11, "deaths", &b);
	cell(doc, "rs_np_", 11, "-", &b); showN(doc, "rs_np_", 11, true); showN(doc, "rs_nm_", 11, false);
	text.putInt(&b, sim.rescueSpace()); text.put(&b, " free berth(s), goal "); text.putInt(&b, cfg.WIN_CREW); text.put(&b, " crew");
	if not t.radar { text.put(&b, " - fit a radar to find survivors"); }
	statusCell(doc, 11, false, &b);

	text.put(&b, "Station efficiency "); text.putInt(&b, (t.efficiency * 100.0) as i32); text.put(&b, "%   (power supply x cooling; scales every module's output)");
	put(doc, "rs_foot", &b);
}

// ---- technology tree (RESEARCH panel) ---------------------------------------------------------------------------------------------------------
// Nodes 1..TECH_COUNT are the scripts/config.evox technologies, laid out in ui/hud.ui (ids tn?_ / tnn?_ / tc?_ / te?_ <id>, a variant per state: l locked,
// a available, x being researched, u researched; connectors ea_ / eb_ / ec_ <id>_<k> are lit once prerequisite k of <id> is researched).
// A click on a node (techN) starts or stops researching it, see sim.selectTech

// "35 / 70 RP" for the selected technology, else the banked points
fn putResearchStock(b : *text.Buf) : void {
	if st.tech_active > 0 {
		text.putInt(b, st.tech_prog[st.tech_active] as i32); text.put(b, " / "); text.putInt(b, cfg.techStats(st.tech_active).cost); text.put(b, " RP");
	} else { text.putInt(b, st.res.rp as i32); text.put(b, " RP"); }
}

fn ttVariant(doc : Document, prefix : []const u8, n : i32, state : i32, b : *text.Buf) : void {
	// writes the buffer into the span of the variant matching the node state and clears it
	var k : text.Buf = undefined;
	text.clear(&k);
	text.put(&k, prefix); text.put(&k, state == 0 ? "l_" : (state == 1 ? "a_" : (state == 2 ? "x_" : "u_"))); text.putInt(&k, n);
	if const e = doc.getElementByID(text.view(&k)) { e.setText(text.view(b)); }
	text.clear(b);
}

fn ttEdge(doc : Document, n : i32, k : i32, lit : bool) : void {
	var id : text.Buf = undefined;
	for p in 0..3 {
		text.clear(&id);
		text.put(&id, p == 0 ? "ea_" : (p == 1 ? "eb_" : "ec_")); text.putInt(&id, n); text.put(&id, "_"); text.putInt(&id, k);
		if const e = doc.getElementByID(text.view(&id)) { e.setVisible(lit); }
	}
}

fn techTree(doc : Document) : void {
	var b : text.Buf = undefined;
	text.clear(&b);
	const rate = st.tot.research * st.tot.efficiency;
	if st.tech_active > 0 {
		const ts = cfg.techStats(st.tech_active);
		const left = (ts.cost as f32) - st.tech_prog[st.tech_active];
		text.put(&b, "Researching "); text.put(&b, ts.name); text.put(&b, ": "); putResearchStock(&b);
		if rate > 0.001 { text.put(&b, ", done in "); putTime(&b, left / rate * 60.0); } else { text.put(&b, " - build a research bench and staff it"); }
		put(doc, "tt_next", &b);
		bar(doc, "tt_bar", st.tech_prog[st.tech_active] / (ts.cost as f32));
	} else {
		text.put(&b, "Nothing selected - click an available technology.");
		if st.res.rp >= 1.0 { text.put(&b, " "); text.putInt(&b, st.res.rp as i32); text.put(&b, " RP banked."); }
		else if rate <= 0.001 { text.put(&b, " Research needs a staffed research bench."); }
		put(doc, "tt_next", &b);
		bar(doc, "tt_bar", 0.0);
	}
	for n in 1..(cfg.TECH_COUNT + 1) {
		const ts = cfg.techStats(n);
		const state = st.techState(n);
		showN(doc, "tnl_", n, state == 0); showN(doc, "tna_", n, state == 1); showN(doc, "tnx_", n, state == 2); showN(doc, "tnu_", n, state == 3);
		text.put(&b, ts.name); ttVariant(doc, "tnn", n, state, &b);
		if state == 3 { text.put(&b, "researched"); }
		else {
			if st.tech_prog[n] >= 1.0 { text.putInt(&b, st.tech_prog[n] as i32); text.put(&b, " / "); }
			text.putInt(&b, ts.cost); text.put(&b, " RP");
		}
		ttVariant(doc, "tc", n, state, &b);
		text.put(&b, ts.effect); ttVariant(doc, "te", n, state, &b);
		ttEdge(doc, n, 0, ts.req_a > 0 and st.tech_done[ts.req_a]);
		ttEdge(doc, n, 1, ts.req_b > 0 and st.tech_done[ts.req_b]);
	}
}

// ---- missions (second section of the OBJECTIVES panel) -------------------------------------------------------------------------------------------------------------------
// radar status, open contacts (ids mc_*_<1..CONTACT_MAX>, each with launch / ignore) and the missions under way (mm_<1..MISSION_MAX>)

fn putPercent(b : *text.Buf, v : f32) : void {
	text.putInt(b, (v * 100.0 + 0.5) as i32); text.put(b, "%");
}

// "+2 crew, +300 kg salvage" etc.: what a contact brings
fn putReward(b : *text.Buf, c : st.Contact) : void {
	const start = b.len;
	if c.crew > 0 { text.put(b, "+"); text.putInt(b, c.crew); text.put(b, " crew "); }
	if c.mixed > 0.5 { text.put(b, "+"); text.putInt(b, c.mixed as i32); text.put(b, " kg salvage "); }
	if c.steel > 0.5 { text.put(b, "+"); text.putInt(b, c.steel as i32); text.put(b, " kg steel "); }
	if c.electronics > 0.5 { text.put(b, "+"); text.putInt(b, c.electronics as i32); text.put(b, " kg elec "); }
	if c.polymers > 0.5 { text.put(b, "+"); text.putInt(b, c.polymers as i32); text.put(b, " kg poly "); }
	if c.fuel_gain > 0.5 { text.put(b, "+"); text.putInt(b, c.fuel_gain as i32); text.put(b, " kg fuel "); }
	if c.water > 0.5 { text.put(b, "+"); text.putInt(b, c.water as i32); text.put(b, " L water "); }
	if b.len == start { text.put(b, "nothing "); }
}

fn missionsPanel(doc : Document) : void {
	var b : text.Buf = undefined;
	text.clear(&b);
	const t = st.tot;
	if t.radar { text.put(&b, "Radar online, "); text.putInt(&b, st.contact_count); text.put(&b, " contact(s)"); }
	else { text.put(&b, "No radar - fit one (ATTACHMENTS) to find contacts"); }
	put(doc, "ms_radar", &b);
	text.put(&b, "Shuttles: "); text.putInt(&b, sim.shipCount(st.SHIP_DOCKED)); text.put(&b, " docked, "); text.putInt(&b, sim.shipCount(st.SHIP_AWAY)); text.put(&b, " away  |  ");
	text.put(&b, "fuel "); text.putInt(&b, st.res.fuel as i32); text.put(&b, " kg  |  drills "); text.putInt(&b, st.res.drills as i32);
	put(doc, "ms_ships", &b);
	for k in 0..cfg.CONTACT_MAX {
		const n = k + 1;
		const open = k < st.contact_count;
		showN(doc, "mc_", n, open);
		if not open { continue; }
		const c = st.contacts[k];
		const s = cfg.missionStats(cfg.missionKind(c.kind));
		text.put(&b, s.name); text.put(&b, " - open "); putTime(&b, c.left); putN(doc, "mc_t_", n, &b);
		const pilot : i32 = -1;   // who goes is chosen on launch, the numbers here are the average crew member's
		var cargo = c;
		cargo.mixed *= sim.missionHaul(pilot);
		cargo.steel *= sim.missionHaul(pilot);
		putReward(&b, cargo); putN(doc, "mc_d_", n, &b);
		if s.needs_ship { text.put(&b, "shuttle flight "); } else if s.needs_crew { text.put(&b, "EVA, "); } else { text.put(&b, "they arrive in "); }
		putTime(&b, sim.missionMinutes(c.kind, pilot));
		if c.fuel > 0.5 { text.put(&b, ", fuel "); text.putInt(&b, c.fuel as i32); text.put(&b, " kg"); }
		if s.needs_drill { text.put(&b, ", 1 drill"); }
		text.put(&b, ", risk "); putPercent(&b, sim.missionRisk(c.kind, pilot));
		if pilot >= 0 { text.put(&b, " ("); text.put(&b, st.crewName(pilot)); text.put(&b, ")"); }
		putN(doc, "mc_c_", n, &b);
		const blocked = sim.launchBlocked(k, &b);
		if not blocked {
			if pilot >= 0 { text.put(&b, "Ready - "); text.put(&b, st.crewName(pilot)); text.put(&b, s.needs_ship ? " flies it" : " goes out"); }
			else { text.put(&b, s.needs_ship ? "Ready - launch, then pick the pilot" : (s.needs_crew ? "Ready - launch, then pick who goes" : "Ready - launch to accept them")); }
		}
		putN(doc, blocked ? "mc_no_" : "mc_ok_", n, &b);
		showN(doc, "mc_ok_", n, not blocked);
		showN(doc, "mc_no_", n, blocked);
	}
	show(doc, "mc_none", t.radar and st.contact_count == 0);
	for k in 0..cfg.MISSION_MAX {
		const n = k + 1;
		const on = k < st.mission_count;
		showN(doc, "mmr_", n, on);
		if not on { continue; }
		const m = st.missions[k];
		const s = cfg.missionStats(cfg.missionKind(m.c.kind));
		if m.worker >= 0 { text.put(&b, st.crewName(m.worker)); text.put(&b, ": "); text.put(&b, s.name); text.put(&b, ", back in "); }
		else { text.put(&b, s.name); text.put(&b, " arriving in "); }
		putTime(&b, m.left);
		putN(doc, "mm_", n, &b);
	}
}

// ---- objectives panel -------------------------------------------------------------------------------------------------------------
// up to 10 active objectives (ids orow_ / ot_ title / oh_ hint / ol_ live numbers <1..10>) and the win goal under them

var g_obj_map : [10]i32 = undefined;   // objectives row k (0-based) -> objective id, for the claim buttons

fn claimRow(k : i32) : void {
	if k < 0 or k >= 10 { return; }
	sim.claimObjective(g_obj_map[k]);
}

fn objectivesPanel(doc : Document) : void {
	var b : text.Buf = undefined;
	text.clear(&b);
	var n : i32 = 0;
	var more : i32 = 0;
	for pass in 0..2 {   // done ones waiting to be claimed first, then the active ones
	for id in 1..(obj.OBJ_COUNT + 1) {
		const waiting = pass == 0;
		if waiting ? not obj.unclaimed(id) : not obj.active(id) { continue; }
		if n >= 10 { more += 1; continue; }
		n += 1;
		g_obj_map[n - 1] = id;
		showN(doc, "oc_", n, waiting);
		text.put(&b, obj.title(id));
		if waiting { text.put(&b, "  - COMPLETE"); }
		const rp = obj.reward(id);
		if rp > 0.0 { text.put(&b, "  +"); text.putInt(&b, rp as i32); text.put(&b, " RP"); }
		putN(doc, "ot_", n, &b);
		const tech = obj.needTech(id);
		if tech > 0 and not st.hasTech(tech) { text.put(&b, "Research: "); text.put(&b, cfg.techStats(tech).name); text.put(&b, ". "); }
		text.put(&b, obj.hint(id));
		putN(doc, "oh_", n, &b);
		obj.putLive(&b, id);
		if b.len == 0 { text.put(&b, " "); }
		putN(doc, "ol_", n, &b);
		showN(doc, "orow_", n, true);
	}
	}
	for k in (n + 1)..11 { showN(doc, "orow_", k, false); g_obj_map[k - 1] = -1; }
	if more > 0 { text.put(&b, "+"); text.putInt(&b, more); text.put(&b, " more objectives"); } else { text.put(&b, " "); }
	put(doc, "obj_more", &b);
	text.put(&b, "Goal: "); text.putInt(&b, st.crew); text.put(&b, " of "); text.putInt(&b, cfg.WIN_CREW); text.put(&b, " crew, stable "); text.putF1(&b, st.stable_days); text.put(&b, " of "); text.putF1(&b, cfg.WIN_STABLE_DAYS); text.put(&b, " days");
	if st.won { text.put(&b, " - done"); }
	put(doc, "obj_goal", &b);
}

// the first active objective in a small always-visible box (the OBJECTIVES panel lists all of them)
fn nextObjective(doc : Document) : void {
	var first : i32 = 0;
	var waiting = false;
	for id in 1..(obj.OBJ_COUNT + 1) { if obj.unclaimed(id) { first = id; waiting = true; break; } }
	if first == 0 { for id in 1..(obj.OBJ_COUNT + 1) { if obj.active(id) { first = id; break; } } }
	show(doc, "nextobj", first > 0 and g_nav != 7 and not st.over);
	if first == 0 { return; }
	var b : text.Buf = undefined;
	text.clear(&b);
	if waiting { text.put(&b, "COMPLETE: "); }
	text.put(&b, obj.title(first));
	const rp = obj.reward(first);
	if rp > 0.0 { text.put(&b, "  +"); text.putInt(&b, rp as i32); text.put(&b, " RP"); }
	put(doc, "no_t", &b);
	const tech = obj.needTech(first);
	if tech > 0 and not st.hasTech(tech) { text.put(&b, "Research: "); text.put(&b, cfg.techStats(tech).name); text.put(&b, ". "); }
	text.put(&b, obj.hint(first));
	put(doc, "no_h", &b);
	obj.putLive(&b, first);
	if b.len == 0 { text.put(&b, " "); }
	put(doc, "no_l", &b);
}

// ---- refresh ---------------------------------------------------------------------------------------------------------------------------

fn refresh(doc : Document) : void {
	var b : text.Buf = undefined;
	text.clear(&b);
	const t = st.tot;
	const o2_net = t.o2_prod * t.efficiency - (st.crew as f32) * sim.O2_PER_CREW;
	const food_net = t.food_prod * t.efficiency - (st.crew as f32) * sim.FOOD_PER_CREW;

	// top bar
	text.putGrouped(&b, st.res.steel as i32); text.put(&b, " kg"); put(doc, "c_steel", &b);
	text.putGrouped(&b, st.res.electronics as i32); text.put(&b, " kg"); put(doc, "c_elec", &b);
	text.putGrouped(&b, st.res.polymers as i32); text.put(&b, " kg"); put(doc, "c_poly", &b);
	text.putGrouped(&b, st.res.parts as i32); text.put(&b, " kg"); put(doc, "c_parts", &b);
	text.putGrouped(&b, st.res.food as i32); text.put(&b, " kcal"); put(doc, "c_food", &b);
	text.putInt(&b, (ratio(st.res.o2, t.o2_cap) * 100.0) as i32); text.put(&b, "%"); put(doc, "c_o2", &b);
	text.putGrouped(&b, t.co2_ppm as i32); text.put(&b, " ppm"); put(doc, "c_co2", &b);
	text.putF1(&b, st.res.altitude); text.put(&b, " km"); put(doc, "c_alt", &b);
	text.putInt(&b, st.res.water as i32); text.put(&b, " L"); put(doc, "c_water", &b);
	text.putF1(&b, t.power_prod); text.put(&b, " / "); text.putF1(&b, t.power_cons); text.put(&b, t.eclipse ? " kW NIGHT" : " kW"); put(doc, "c_power", &b);
	text.putInt(&b, st.crew); text.put(&b, " / "); text.putInt(&b, t.crew_cap); put(doc, "c_crew", &b);
	putResearchStock(&b); put(doc, "c_rp", &b);


	show(doc, "menu", st.menu);
	show(doc, "mn_continue", not st.game_started and save.exists());
	show(doc, "mn_start", not st.game_started);
	show(doc, "mn_resume", st.game_started);
	show(doc, "mn_new", st.game_started);
	show(doc, "mn_help", g_help);
	if g_nav == 7 { objectivesPanel(doc); missionsPanel(doc); }
	nextObjective(doc);

	// navigation: side panels and the build tray follow the selected nav item
	for i in 0..8 { showN(doc, "nav_", i, g_nav != i); showN(doc, "nava_", i, g_nav == i); }
	show(doc, "p_crew", g_nav == 4);
	show(doc, "p_res", g_nav == 5);
	show(doc, "p_rsch", g_nav == 6);
	show(doc, "p_obj", g_nav == 7);
	show(doc, "buildbar", g_nav >= 0 and g_nav < 4);
	text.put(&b, st.tab == 0 ? "S T R U C T U R E" : (st.tab == 1 ? "E X T E N S I O N S" : (st.tab == 2 ? "R A C K S" : "A T T A C H M E N T S"))); put(doc, "bld_hd", &b);

	// crew panel
	if g_nav == 4 { crewRoster(doc); }

	if g_nav == 5 { resourcesPanel(doc); }
	pickPopup(doc);
	tasksPanel(doc);
	modulePanel(doc);

	// research panel
	text.put(&b, "+"); text.putF1(&b, t.research * t.efficiency); text.put(&b, " RP per hour"); put(doc, "rp_line", &b);
	if g_nav == 6 { techTree(doc); }


	// toasts
	show(doc, "al_o2", st.res.o2 < cfg.ALERT_LOW_O2);
	show(doc, "al_food", st.res.food < cfg.ALERT_LOW_FOOD);
	show(doc, "al_co2", t.co2_ppm >= cfg.CO2_WARN_PPM);
	show(doc, "al_water", st.res.water < cfg.ALERT_LOW_WATER);
	var low_hp : f32 = 1.0;
	const low = sim.worstModule(&low_hp);
	show(doc, "al_hp", low >= 0 and low_hp < cfg.HP_WARN and not st.over);
	if low >= 0 and low_hp < cfg.HP_WARN { text.put(&b, defs.getDef(st.modules[low].kind).name); text.put(&b, " at "); text.putInt(&b, (low_hp * 100.0) as i32); text.put(&b, "% - select it to repair"); put(doc, "al_hp_t", &b); }
	show(doc, "al_orbit", st.res.altitude < cfg.ALT_WARN_KM and not st.boosting and not st.over);
	if st.res.altitude < cfg.ALT_WARN_KM { text.put(&b, "Orbit decaying - reboost! Re-entry in "); putTime(&b, minutesUntilAltitude(cfg.ALT_REENTRY_KM)); put(doc, "al_orbit_t", &b); }
	// out of shape: whoever is least fit, if below the level where it costs them
	var unfit : i32 = -1;
	for c in 0..st.crew_slots {
		const cm = st.crew_list[c];
		if cm.alive and cm.job != st.JOB_EXERCISE and cm.fitness < cfg.FITNESS_LOW and (unfit < 0 or cm.fitness < st.crew_list[unfit].fitness) { unfit = c; }
	}
	show(doc, "al_fit", unfit >= 0 and not st.over);
	if unfit >= 0 {
		text.put(&b, st.crewName(unfit)); text.put(&b, " is out of shape ("); text.putInt(&b, (st.crew_list[unfit].fitness * 100.0) as i32);
		text.put(&b, "% fit) - use an exercise machine"); put(doc, "al_fit_t", &b);
	}
	show(doc, "al_power", t.power_ratio < 0.999);
	show(doc, "al_heat", t.overheating);
	show(doc, "al_rescue", st.contact_count > 0 and g_nav != 7 and not st.over);
	if st.contact_count > 0 {
		text.put(&b, " "); text.putInt(&b, st.contact_count); text.put(&b, st.contact_count == 1 ? " radar contact" : " radar contacts"); text.put(&b, " - see OBJECTIVES");
		put(doc, "al_rescue_t", &b);
	}
	for i in 0..3 {
		show(doc, logRowId(i), i < st.msg_count);
		if i < st.msg_count { text.put(&b, st.msgText(i)); put(doc, logId(i), &b); }
	}

	// build bar: tabs, selected socket, cards
	for i in 0..4 {
		showN(doc, "tab_", i, st.tab != i);
		showN(doc, "taba_", i, st.tab == i);
	}
	attachCards(doc);
	rackCards(doc);
	var shown = false;
	for i in 1..defs.KIND_COUNT {
		const kind = defs.kindFromIndex(i);
		const d = defs.getDef(kind);
		// every module of the category is listed; the card status says why it cannot be placed on the selected socket
		const visible = tabOf(kind) == st.tab;
		showN(doc, "card_", i, visible);
		if visible {
			shown = true;
			text.put(&b, d.name); putN(doc, "cname_", i, &b);
			text.put(&b, " "); text.putInt(&b, d.steel); putN(doc, "cs_", i, &b);   // the space keeps the number off its icon
			text.put(&b, " "); text.putInt(&b, d.electronics); putN(doc, "ce_", i, &b);
			text.put(&b, " "); text.putInt(&b, d.polymers); putN(doc, "cp_", i, &b);
			text.put(&b, " "); text.putInt(&b, d.parts); text.put(&b, " kg"); putN(doc, "cm_", i, &b);
			showN(doc, "cbs_", i, d.steel > 0);
			showN(doc, "cbe_", i, d.electronics > 0);
			showN(doc, "cbp_", i, d.polymers > 0);
			showN(doc, "cbm_", i, d.parts > 0);
			if not build.unlocked(d) { text.put(&b, "locked"); }
			else if not build.canAfford(d) { text.put(&b, "need materials"); }
			else if st.build_kind == i and st.aim_socket >= 0 and build.g_ghost_why.length > 0 { text.put(&b, build.g_ghost_why); }
			else if st.build_kind == i { text.put(&b, "R turns, LMB builds"); }
			else { text.put(&b, "click, aim at a port"); }
			putN(doc, "cst_", i, &b);
		}
	}
	text.put(&b, " ");
	put(doc, "b_empty", &b);
	show(doc, "build_empty", false);
	show(doc, "center_msg", g_result.length > 0 and not st.menu and not g_pick);
	if g_result.length > 0 { text.put(&b, g_result); } else { text.put(&b, " "); }
	put(doc, "center_msg_t", &b);

	// info callout for the hovered card
	show(doc, "tip", g_hover > 0);
	if g_hover > 200 {
		const s = cfg.rackStats(cfg.rackKind(g_hover - 200));
		text.put(&b, s.name); put(doc, "tip_title", &b);
		text.put(&b, s.large_only ? "Fits into a free rack slot of a Large hull." : "Fits into a free rack slot of any hull or the Central Module."); if not build.rackUnlocked(s) { text.put(&b, " Research: "); text.put(&b, cfg.techStats(s.unlock).name); text.put(&b, "."); } put(doc, "tip_desc", &b);
		text.put(&b, s.effect); text.put(&b, ", "); text.putF1(&b, s.power); text.put(&b, " kW, "); text.putF1(&b, s.mass); text.put(&b, " t"); put(doc, "tip_fx", &b);
		putCostLine(&b, s.steel, s.electronics, s.polymers, s.parts); put(doc, "tip_cost", &b);
	} else if g_hover > 100 {
		const s = cfg.attachStats(cfg.attachKind(g_hover - 100));
		text.put(&b, s.name); put(doc, "tip_title", &b);
		text.put(&b, "Bolts onto a free hull slot of any module."); if not build.attachUnlocked(s) { text.put(&b, " Research: "); text.put(&b, cfg.techStats(s.unlock).name); text.put(&b, "."); } put(doc, "tip_desc", &b);
		text.put(&b, s.effect); text.put(&b, ", "); text.putF1(&b, s.mass); text.put(&b, " t"); put(doc, "tip_fx", &b);
		putCostLine(&b, s.steel, s.electronics, s.polymers, s.parts); put(doc, "tip_cost", &b);
	} else if g_hover > 0 {
		const kind = defs.kindFromIndex(g_hover);
		const d = defs.getDef(kind);
		text.put(&b, d.name); put(doc, "tip_title", &b);
		text.put(&b, blurb(kind)); if not build.unlocked(d) { text.put(&b, " Research: "); text.put(&b, cfg.techStats(d.unlock).name); text.put(&b, "."); } put(doc, "tip_desc", &b);
		effectText(&b, d); text.put(&b, " "); put(doc, "tip_fx", &b);
		putCostLine(&b, d.steel, d.electronics, d.polymers, d.parts); put(doc, "tip_cost", &b);
	}

	// behind the main menu the rest of the HUD is hidden
	show(doc, "topbar", not st.menu); show(doc, "nav", not st.menu); show(doc, "toasts", not st.menu);
	if st.menu or g_pick {   // the crew choice popup stands alone too
		show(doc, "buildbar", false); show(doc, "p_crew", false); show(doc, "p_res", false); show(doc, "p_rsch", false);
		show(doc, "p_obj", false); show(doc, "modinfo", false); show(doc, "tip", false); show(doc, "nextobj", false);
	}

	// banner
	show(doc, "banner", st.over or st.won);
	show(doc, "restart_btn", st.over);
	if st.over { text.put(&b, st.reentered ? "GAME OVER - the station re-entered the atmosphere." : "GAME OVER - all crew are lost."); put(doc, "banner_text", &b); }
	else if st.won { text.put(&b, "FOOTHOLD ESTABLISHED! Keep expanding."); put(doc, "banner_text", &b); }
}

// ---- input -----------------------------------------------------------------------------------------------------------------------------

fn doBuild(world : World, index : i32) : void {
	// a card arms the module (click again to cancel); the world click builds it on the socket under the cursor
	st.build_kind = st.build_kind == index ? 0 : index;
	st.build_attach = 0;
	st.build_rack = 0;
	st.build_seed = rnd.rand();
	g_result = "";
}

fn doFitRack(index : i32) : void {
	st.build_rack = st.build_rack == index ? 0 : index;
	st.build_kind = 0;
	st.build_attach = 0;
	g_result = "";
}

// next job of the selected module's n-th rack (a workshop bench)
fn jobNth(n : i32) : void {
	const i = build.rackOf(st.selected_module, n);
	if i >= 0 { build.cycleJob(i); g_timer = 0.0; }
}

// staffs / frees the selected module's n-th rack (a bench)
fn staffNth(n : i32) : void {
	const i = build.rackOf(st.selected_module, n);
	if i >= 0 { build.staffRack(i); }
}

// removes the selected module's n-th rack
fn removeNthRack(n : i32) : void {
	const i = build.rackOf(st.selected_module, n);
	if i >= 0 { build.removeRack(i); }
}

fn hasRack(kind : i32) : bool {
	for i in 0..st.rack_count { if st.racks[i].kind == kind { return true; } }
	return false;
}

fn doBuildAttach(index : i32) : void {
	st.build_attach = st.build_attach == index ? 0 : index;
	st.build_kind = 0;
	st.build_rack = 0;
	g_result = "";
}

fn restart(world : World) : void {
	build.teardown(world);
	build.startStation(world);
	g_result = "";
}

fn handle(world : World, doc : Document) : void {
	for event in doc.getEvents() {
		// a click or move over empty space carries no element (0xFFFFFFFF): getElement would index out of range
		const no_element = event.element_index == 0xFFFFFFFF;
		if no_element and (event.type == .MOUSE_ENTER or event.type == .MOUSE_LEAVE or event.type == .MOUSE_DOWN) {
			// a click on empty space is world input, not HUD
			continue;
		}
		if event.type == .MOUSE_ENTER {
			if const e = doc.getElement(event.element_index) {
				const h = hoverIndex(e.getID());
				if h > 0 { g_hover = h; g_timer = 0.0; }
			}
			continue;
		}
		if event.type == .MOUSE_LEAVE {
			if const e = doc.getElement(event.element_index) {
				const h = hoverIndex(e.getID());
				if h > 0 and h == g_hover { g_hover = 0; g_timer = 0.0; }
			}
			continue;
		}
		if event.type == .MOUSE_DOWN {
			// anything but the full-screen root box under the cursor is HUD: such a click must not build in the world
			if const e = doc.getElement(event.element_index) { if e.getID() != "hud" { g_ui_down = true; } }
			continue;
		}
		if event.type != .ACTION { continue; }
		act(world, event.action);
		g_timer = 0.0;
	}
}

// runs an action; one that needs a crew member (st.takeCrew) and has none yet opens the choice popup instead, see askCrew
fn act(world : World, action : []const u8) : void {
	st.crew_wanted = false;
	dispatch(world, action);
	if st.crew_wanted { askCrew(action); }
}

fn dispatch(world : World, action : []const u8) : void {
	match action {
		case "speed0": st.speed = 0;
		case "speed1": st.speed = 1;
		case "speed2": st.speed = 2;
		case "speed3": st.speed = 3;
		case "tab0": st.tab = 0;
		case "tab1": st.tab = 1;
		case "tab2": st.tab = 2;
		case "tab3": st.tab = 3;
		case "tab4": st.tab = 4;
		case "nav0": navToggle(0);
		case "nav1": navToggle(1);
		case "nav2": navToggle(2);
		case "nav3": navToggle(3);
		case "nav4": navToggle(4);
		case "nav5": navToggle(5);
		case "nav6": navToggle(6);
		case "nav7": navToggle(7);
		case "tech1": sim.selectTech(1);
		case "tech2": sim.selectTech(2);
		case "tech3": sim.selectTech(3);
		case "tech4": sim.selectTech(4);
		case "tech5": sim.selectTech(5);
		case "tech6": sim.selectTech(6);
		case "tech7": sim.selectTech(7);
		case "tech8": sim.selectTech(8);
		case "tech9": sim.selectTech(9);
		case "tech10": sim.selectTech(10);
		case "tech11": sim.selectTech(11);
		case "tech12": sim.selectTech(12);
		case "tech13": sim.selectTech(13);
		case "tech14": sim.selectTech(14);
		case "tech15": sim.selectTech(15);
		case "tech16": sim.selectTech(16);
		case "tech17": sim.selectTech(17);
		case "tech18": sim.selectTech(18);
		case "tech19": sim.selectTech(19);
		case "tech20": sim.selectTech(20);
		case "tech21": sim.selectTech(21);
		case "tech22": sim.selectTech(22);
		case "tech23": sim.selectTech(23);
		case "tech24": sim.selectTech(24);
		case "tech25": sim.selectTech(25);
		case "tech26": sim.selectTech(26);
		case "tech27": sim.selectTech(27);
		case "tech28": sim.selectTech(28);
		case "tech29": sim.selectTech(29);
		case "tech30": sim.selectTech(30);
		case "tech31": sim.selectTech(31);
		case "boost": sim.toggleBoost();
		case "mrepair": if st.selected_attach >= 0 { sim.repairAttachment(st.selected_attach); } else { sim.repair(st.selected_module); }
		case "mdismantle": build.dismantle(world, st.selected_attach); if not st.crew_wanted { st.selected_attach = -1; }   // asking for a crew member keeps it selected for the replay
		case "mclose": st.selected_module = -1; st.selected_attach = -1;
		case "pick1": pickCrew(world, 0);
		case "pick2": pickCrew(world, 1);
		case "pick3": pickCrew(world, 2);
		case "pick4": pickCrew(world, 3);
		case "pick5": pickCrew(world, 4);
		case "pick6": pickCrew(world, 5);
		case "pick7": pickCrew(world, 6);
		case "pick8": pickCrew(world, 7);
		case "pick9": pickCrew(world, 8);
		case "pick10": pickCrew(world, 9);
		case "pick11": pickCrew(world, 10);
		case "pick12": pickCrew(world, 11);
		case "claim1": claimRow(0);
		case "claim2": claimRow(1);
		case "claim3": claimRow(2);
		case "claim4": claimRow(3);
		case "claim5": claimRow(4);
		case "claim6": claimRow(5);
		case "claim7": claimRow(6);
		case "claim8": claimRow(7);
		case "claim9": claimRow(8);
		case "claim10": claimRow(9);
		case "pickcancel": g_pick = false;
		case "place": placeNow(world);
		case "resume": const resumed = build.resumeWork(g_pend_mod, g_pend_att);
		case "rkjob_1": jobNth(0);
		case "rkjob_2": jobNth(1);
		case "rkjob_3": jobNth(2);
		case "rkjob_4": jobNth(3);
		case "rkjob_5": jobNth(4);
		case "rkjob_6": jobNth(5);
		case "rkjob_7": jobNth(6);
		case "rkjob_8": jobNth(7);
		case "rkjob_9": jobNth(8);
		case "rkjob_10": jobNth(9);
		case "rkstaff_1": staffNth(0);
		case "rkstaff_2": staffNth(1);
		case "rkstaff_3": staffNth(2);
		case "rkstaff_4": staffNth(3);
		case "rkstaff_5": staffNth(4);
		case "rkstaff_6": staffNth(5);
		case "rkstaff_7": staffNth(6);
		case "rkstaff_8": staffNth(7);
		case "rkstaff_9": staffNth(8);
		case "rkstaff_10": staffNth(9);
		case "rbuild_1": doFitRack(1);
		case "rbuild_2": doFitRack(2);
		case "rbuild_3": doFitRack(3);
		case "rbuild_4": doFitRack(4);
		case "rbuild_5": doFitRack(5);
		case "rbuild_6": doFitRack(6);
		case "rbuild_7": doFitRack(7);
		case "rbuild_8": doFitRack(8);
		case "rbuild_9": doFitRack(9);
		case "rbuild_10": doFitRack(10);
		case "rbuild_11": doFitRack(11);
		case "rbuild_12": doFitRack(12);
		case "rbuild_13": doFitRack(13);
		case "rbuild_14": doFitRack(14);
		case "rkdis_1": removeNthRack(0);
		case "rkdis_2": removeNthRack(1);
		case "rkdis_3": removeNthRack(2);
		case "rkdis_4": removeNthRack(3);
		case "rkdis_5": removeNthRack(4);
		case "rkdis_6": removeNthRack(5);
		case "rkdis_7": removeNthRack(6);
		case "rkdis_8": removeNthRack(7);
		case "rkdis_9": removeNthRack(8);
		case "rkdis_10": removeNthRack(9);
		case "abuild_1": doBuildAttach(1);
		case "abuild_2": doBuildAttach(2);
		case "abuild_3": doBuildAttach(3);
		case "abuild_4": doBuildAttach(4);
		case "abuild_5": doBuildAttach(5);
		case "abuild_6": doBuildAttach(6);
		case "abuild_7": doBuildAttach(7);
		case "abuild_8": doBuildAttach(8);
		case "abuild_9": doBuildAttach(9);
		case "abuild_10": doBuildAttach(10);
		case "abuild_11": doBuildAttach(11);
		case "mlaunch_1": sim.launchMission(0);
		case "mlaunch_2": sim.launchMission(1);
		case "mlaunch_3": sim.launchMission(2);
		case "mignore_1": sim.ignoreContact(0);
		case "mignore_2": sim.ignoreContact(1);
		case "mignore_3": sim.ignoreContact(2);
		case "mlaunch_4": sim.launchMission(3);
		case "mignore_4": sim.ignoreContact(3);
		case "mship": sim.buildShip(st.selected_module);
		case "restart": restart(world);
		case "menu_open": st.menu = true;
		case "menu_start": st.menu = false; st.game_started = true;
		case "menu_new": restart(world); st.menu = false; st.game_started = true; g_nav = 7;
		case "menu_controls": g_help = not g_help;
		case "menu_continue":
			if save.load(world) { st.menu = false; st.game_started = true; g_result = ""; g_nav = 7; }
			else { g_result = "Could not load the saved game."; g_result_t = 4.0; }
		case "build_1": doBuild(world, 1);
		case "build_2": doBuild(world, 2);
		case "build_3": doBuild(world, 3);
		case "build_4": doBuild(world, 4);
		case "build_5": doBuild(world, 5);
		case "build_6": doBuild(world, 6);
		case "build_7": doBuild(world, 7);
		case "build_8": doBuild(world, 8);
		case "build_9": doBuild(world, 9);
		case "build_10": doBuild(world, 10);
		case "build_11": doBuild(world, 11);
		case "build_12": doBuild(world, 12);
		case: selectCrewIndex(rosterIndex(action));   // crsel_<n>: a row of the crew roster
	}
}

fn update(world : World, dt : f32) : void {
	var ui = world.ui() else return;
	if not ui.isReady() {
		if not g_warned { g_warned = true; logInfo("[game] hud: ui document not ready yet"); }
		return;
	}
	if not g_seen { g_seen = true; logInfo("[game] hud: ui document ready, first refresh"); }
	const doc = ui.getDocument();
	handle(world, doc);
	if g_result_t > 0.0 {
		g_result_t -= dt;
		if g_result_t <= 0.0 { g_result = ""; g_timer = 0.0; }
	}
	g_timer -= dt;
	if g_timer <= 0.0 {
		g_timer = 0.25;
		refresh(doc);
	}
}

// true once if the last mouse press hit the HUD
fn uiDown() : bool {
	const v = g_ui_down;
	g_ui_down = false;
	return v;
}

// LMB in the world while a module is armed
// LMB in the world: builds the armed module, or (when nothing is armed) selects the module under the cursor, or deselects
fn placeAimed(world : World) : void {
	if g_pick { g_pick = false; return; }   // a click away from the crew popup closes it
	st.crew_wanted = false;
	if st.build_kind > 0 or st.build_attach > 0 or st.build_rack > 0 {
		g_pend_rack_host = st.build_rack > 0 ? build.pickModule(st.mouse_x, st.mouse_y) : -1;
		placeNow(world);
		if st.crew_wanted { askCrew("place"); }
		return;
	}
	// an attachment in front of the module it sits on wins (it is small and on the module's surface)
	const mod = build.pickModule(st.mouse_x, st.mouse_y);
	const att = build.pickAttachment(st.mouse_x, st.mouse_y, build.moduleHitDistance(st.mouse_x, st.mouse_y, mod));
	g_pend_mod = mod;
	g_pend_att = att;
	resumeNow();
	if st.crew_wanted { askCrew("resume"); }
	st.selected_attach = att;
	st.selected_module = att >= 0 ? -1 : mod;
	g_timer = 0.0;
}
